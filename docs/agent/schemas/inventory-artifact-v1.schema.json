{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:laibin:agent:artifact:v1",
  "title": "Agent Artifact Envelope V1",
  "description": "M2-0 通用展示契约草案。由 Java 确定性生成，模型和前端不得扩展 HTML、链接、按钮或组件名。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "artifactType",
    "title",
    "asOf",
    "provenance",
    "limitations",
    "pagination",
    "renderHints",
    "sensitivity",
    "fallbackText"
  ],
  "oneOf": [
    {
      "required": ["data"]
    },
    {
      "required": ["resultRef"]
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^art_[A-Za-z0-9_-]{8,80}$"
    },
    "artifactType": {
      "type": "string",
      "enum": ["metric_grid", "data_table", "chart", "warning", "text"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "data": {
      "type": "object"
    },
    "resultRef": {
      "type": "string",
      "pattern": "^res_[A-Za-z0-9_-]{8,80}$"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "limitations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "pagination": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/pagination"
        }
      ]
    },
    "renderHints": {
      "$ref": "#/$defs/renderHints"
    },
    "sensitivity": {
      "type": "string",
      "enum": ["BUSINESS_INTERNAL", "RESTRICTED"]
    },
    "fallbackText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifactType": {
            "const": "metric_grid"
          }
        },
        "required": ["artifactType"]
      },
      "then": {
        "required": ["data"],
        "properties": {
          "data": {
            "$ref": "#/$defs/metricGridData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifactType": {
            "const": "data_table"
          }
        },
        "required": ["artifactType"]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/dataTableData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifactType": {
            "const": "chart"
          }
        },
        "required": ["artifactType"]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/chartData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifactType": {
            "enum": ["warning", "text"]
          }
        },
        "required": ["artifactType"]
      },
      "then": {
        "required": ["data"],
        "properties": {
          "data": {
            "$ref": "#/$defs/textData"
          }
        }
      }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "datasetVersion", "queryPlanHash", "auditRef"],
      "properties": {
        "datasetId": {
          "const": "inventory_current_snapshot_v1"
        },
        "datasetVersion": {
          "const": "1.0"
        },
        "queryPlanHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "auditRef": {
          "type": "string",
          "pattern": "^aud_[A-Za-z0-9_-]{8,80}$"
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "returnedRows", "hasMore"],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "returnedRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "hasMore": {
          "type": "boolean"
        },
        "nextPageRef": {
          "type": "string",
          "pattern": "^page_[A-Za-z0-9_-]{8,80}$"
        }
      }
    },
    "renderHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compactOnMobile": {
          "type": "boolean",
          "default": true
        },
        "maxVisibleColumns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "preferredOrientation": {
          "type": "string",
          "enum": ["AUTO", "PORTRAIT", "LANDSCAPE"]
        }
      }
    },
    "metricGridData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "value", "unit"],
            "properties": {
              "key": {
                "type": "string",
                "enum": ["inventory_record_count", "equivalent_pieces", "total_weight_kg"]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "value": {
                "type": ["integer", "number", "string", "null"]
              },
              "unit": {
                "type": "string",
                "enum": ["RECORD", "PIECE", "KG"]
              }
            }
          }
        }
      }
    },
    "dataTableData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "valueType"],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,49}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "valueType": {
                "type": "string",
                "enum": ["TEXT", "INTEGER", "DECIMAL", "DATE"]
              },
              "unit": {
                "type": "string",
                "enum": ["NONE", "RECORD", "PIECE", "KG"]
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "integer", "number", "boolean", "null"]
            }
          }
        }
      }
    },
    "chartData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chartType", "categoryField", "series"],
      "properties": {
        "chartType": {
          "type": "string",
          "enum": ["bar", "line"]
        },
        "categoryField": {
          "type": "string",
          "enum": ["product", "product_type", "warehouse", "warehouse_side", "inbound_date"]
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["measure", "label", "unit", "points"],
            "properties": {
              "measure": {
                "type": "string",
                "enum": ["inventory_record_count", "equivalent_pieces", "total_weight_kg"]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "unit": {
                "type": "string",
                "enum": ["RECORD", "PIECE", "KG"]
              },
              "points": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["category", "value"],
                  "properties": {
                    "category": {
                      "type": "string",
                      "maxLength": 120
                    },
                    "value": {
                      "type": ["integer", "number", "null"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "textData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 28rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.brand-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  font-size: 24rpx;
  color: #246bfe;
  font-weight: 700;
}

.title {
  margin-top: 8rpx;
  font-size: 52rpx;
  line-height: 1.1;
  font-weight: 800;
  color: #172033;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #647089;
}

.panel,
.guide {
  padding: 32rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(23, 32, 51, 0.06);
}

.panel-title,
.guide-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #172033;
}

.panel-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #647089;
}

.primary-btn {
  margin-top: 30rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: #246bfe;
  font-size: 30rpx;
  font-weight: 700;
}

.primary-btn::after,
.link-btn::after {
  border: 0;
}

.bind-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.link-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  border-radius: 8rpx;
  color: #246bfe;
  background: #eaf1ff;
  font-size: 26rpx;
}

.guide-item {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #647089;
}


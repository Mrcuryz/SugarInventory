<page-shell>
  <page-header title="工号绑定" subtitle="手机号无法匹配时，可用工号和姓名完成身份校验。" showBack="{{true}}" />
  <view class="bind-card">
    <view class="field">
      <text class="label">工号</text>
      <input class="input" placeholder="请输入员工工号" value="{{employeeId}}" data-field="employeeId" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">姓名</text>
      <input class="input" placeholder="请输入姓名或姓名关键字" value="{{namePart}}" data-field="namePart" bindinput="onInput" />
    </view>
    <button class="primary-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onBind">完成绑定</button>
  </view>
</page-shell>


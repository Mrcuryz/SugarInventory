.bind-page {
  position: relative;
  min-height: calc(100vh - 74rpx);
  overflow: hidden;
  padding-bottom: 80rpx;
}

.bg-circle {
  position: absolute;
  top: 26rpx;
  left: -132rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(176, 203, 255, 0.66);
}

.bg-circle-ring {
  position: absolute;
  top: -10rpx;
  left: -170rpx;
  width: 356rpx;
  height: 356rpx;
  border-radius: 50%;
  border: 36rpx solid rgba(255, 255, 255, 0.34);
}

.dot-grid {
  position: absolute;
  top: 30rpx;
  right: 8rpx;
  width: 150rpx;
}

.dot-row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(170, 196, 245, 0.58);
}

.hero,
.main-card,
.tips-card {
  position: relative;
  z-index: 2;
}

.hero {
  margin-top: 28rpx;
  padding: 12rpx 8rpx 0;
  text-align: center;
}

.hero-badge {
  display: inline-flex;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(49, 118, 255, 0.12);
  color: #2f74ff;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 52rpx;
  line-height: 1.14;
  font-weight: 800;
  color: #13234a;
}

.hero-desc {
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #647089;
}

.main-card,
.tips-card {
  margin-top: 30rpx;
  padding: 36rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(220, 229, 246, 0.95);
  box-shadow: 0 18rpx 42rpx rgba(47, 82, 148, 0.11);
}

.card-title,
.tips-title {
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #13234a;
}

.card-desc {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: #6d7b95;
}

.field + .field {
  margin-top: 22rpx;
}

.field {
  margin-top: 26rpx;
}

.label {
  margin-bottom: 12rpx;
  font-size: 25rpx;
  color: #647089;
  font-weight: 600;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  border: 1rpx solid #dbe5f6;
  background: #f9fbff;
  font-size: 28rpx;
  color: #172033;
}

.primary-btn {
  margin-top: 30rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #3a7cff 0%, #246bfe 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 26rpx rgba(36, 107, 254, 0.24);
}

.primary-btn::after {
  border: 0;
}

.tips-card {
  background: rgba(246, 250, 255, 0.96);
}

.tips-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 22rpx;
}

.tips-index {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(49, 118, 255, 0.12);
  color: #246bfe;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
  font-weight: 700;
}

.tips-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.68;
  color: #647089;
}

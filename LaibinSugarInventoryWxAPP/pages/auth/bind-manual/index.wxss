.bind-card {
  padding: 32rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(23, 32, 51, 0.06);
}

.field + .field {
  margin-top: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  color: #647089;
}

.input {
  width: 100%;
  height: 82rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d8e0ec;
  border-radius: 8rpx;
  background: #fbfcfe;
  font-size: 28rpx;
}

.primary-btn {
  height: 82rpx;
  line-height: 82rpx;
  margin: 34rpx 0 0;
  border-radius: 8rpx;
  color: #ffffff;
  background: #246bfe;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-btn::after {
  border: 0;
}


<page-shell safeBottom="{{true}}">
  <page-header title="生产订单详情" subtitle="查看订单进度，成品生产订单可扫码领用半成品。" />

  <view wx:if="{{detail}}" class="order-card">
    <view class="order-head">
      <view>
        <view class="order-no">{{detail.baseInfo.orderNo}}</view>
        <view class="order-meta">{{detail.baseInfo.orderTypeText}} · {{detail.baseInfo.productionDate}}</view>
      </view>
      <status-tag label="{{detail.baseInfo.statusLabel}}" type="{{detail.baseInfo.statusType}}" />
    </view>
    <view class="summary-grid">
      <view>
        <text>计划领用</text>
        <strong>{{detail.baseInfo.plannedMaterialText}}</strong>
      </view>
      <view>
        <text>计划产出</text>
        <strong>{{detail.baseInfo.plannedOutputText}}</strong>
      </view>
    </view>
  </view>

  <view wx:if="{{detail && detail.baseInfo.orderType === 'FINISH'}}" class="section-card">
    <view class="section-head">
      <view>
        <view class="section-title">半成品扫码领用</view>
        <view class="section-desc">确认后库存移出、关联到当前生产订单，原二维码释放为可复用状态。</view>
      </view>
      <button class="primary-btn" loading="{{picking}}" disabled="{{picking}}" bindtap="scanMaterial">扫码领用</button>
    </view>

    <view wx:if="{{pendingMaterial}}" class="pending-card">
      <view class="pending-title">待确认半成品</view>
      <view class="info-row"><text>二维码</text><strong>{{pendingMaterial.code}}</strong></view>
      <view class="info-row"><text>产品</text><strong>{{pendingMaterial.productName}}</strong></view>
      <view class="info-row"><text>产品状态</text><strong>{{pendingMaterial.productStatus}}</strong></view>
      <view class="info-row"><text>生产日期</text><strong>{{pendingMaterial.productionDate}}</strong></view>
      <view class="info-row"><text>数量</text><strong>{{pendingMaterial.quantityText}}</strong></view>
      <view class="info-row"><text>库位</text><strong>{{pendingMaterial.locationText}}</strong></view>
      <view class="pending-actions">
        <button class="plain-btn" bindtap="clearPendingMaterial">取消</button>
        <button class="primary-btn" loading="{{picking}}" disabled="{{picking}}" bindtap="confirmPickMaterial">确认领用</button>
      </view>
    </view>
  </view>

  <view wx:if="{{detail}}" class="section-card">
    <view class="section-title">已领用半成品</view>
    <view wx:if="{{detail.materials.length}}">
      <view wx:for="{{detail.materials}}" wx:key="id" class="list-row">
        <view>
          <view class="row-title">{{item.productName}}</view>
          <view class="row-meta">{{item.palletCode}} · {{item.quantityText}}</view>
          <view class="row-meta">{{item.locationText}} · {{item.pickedAtText}}</view>
        </view>
      </view>
    </view>
    <empty-state wx:else icon="/assets/icons-line/icon-task.svg" title="暂无领用记录" description="成品生产订单扫码领用后会显示在这里。" />
  </view>

  <view wx:if="{{detail}}" class="section-card">
    <view class="section-title">预打印批次</view>
    <view wx:if="{{detail.labelBatches.length}}">
      <view wx:for="{{detail.labelBatches}}" wx:key="id" class="list-row">
        <view>
          <view class="row-title">{{item.batchNo}}</view>
          <view class="row-meta">{{item.productName}} · 预留{{item.reservedCount || 0}} · 已用{{item.usedCount || 0}} · 回收{{item.recycledCount || 0}}</view>
          <view class="row-meta">{{item.statusLabel}} · {{item.printedAtText}}</view>
        </view>
      </view>
    </view>
    <empty-state wx:else icon="/assets/icons-line/icon-task.svg" title="暂无预打印批次" description="后台预分配并打印后会显示在这里。" />
  </view>

  <view wx:if="{{detail}}" class="section-card">
    <view class="section-title">实际产出</view>
    <view wx:if="{{detail.outputs.length}}">
      <view wx:for="{{detail.outputs}}" wx:key="id" class="output-card">
        <view class="row-title">{{item.productName}}</view>
        <view class="row-meta">{{item.productionDate}} · {{item.quantityText}} · 入库 {{item.inboundQrCount || 0}}/{{item.boundQrCount || 0}}</view>
        <view wx:for="{{item.codes}}" wx:key="id" class="code-row">
          <text>{{item.palletCode}}</text>
          <text>{{item.quantityText}}</text>
          <text>{{item.status}}</text>
        </view>
      </view>
    </view>
    <empty-state wx:else icon="/assets/icons-line/icon-task.svg" title="暂无实际产出" description="确认生产结束后会生成实际产出和入库任务。" />
  </view>

  <view wx:if="{{!detail && !loading}}" class="empty-wrap">
    <empty-state icon="/assets/icons-line/icon-task.svg" title="订单详情为空" description="请返回生产作业列表重新选择订单。" />
  </view>
</page-shell>

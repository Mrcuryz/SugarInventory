<page-meta page-style="{{confirmVisible ? 'overflow: hidden; height: 100vh;' : ''}}"></page-meta>
<page-shell safeBottom="{{true}}">
  <page-header title="二维码详情" subtitle="单码全链路查询" showBack="{{true}}" actionText="刷新" bind:action="refresh" />

  <view wx:if="{{loading}}" class="light-card loading-card">正在加载二维码信息...</view>

  <block wx:else>
    <pallet-summary-card pallet="{{pallet}}" summary="{{summary}}" />

    <view class="detail-tabs segmented">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="detail-tab segmented-item {{activeTab === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTabTap"
      >{{item.label}}</view>
    </view>

    <block wx:if="{{activeTab === 'base'}}">
      <view class="section-title">基础档案</view>
      <view class="grid-card">
        <view wx:for="{{baseFields}}" wx:key="label" class="meta-item">
          <text class="meta-label">{{item.label}}</text>
          <text class="meta-value">{{item.value}}</text>
        </view>
      </view>

      <view class="section-title">当前位置</view>
      <view wx:if="{{inventory}}" class="light-card location-card">
        <view class="card-head">
          <view class="card-title">当前库位</view>
          <status-tag label="{{inventory.unit ? '件托' : '板托'}}" type="info" />
        </view>
        <view class="location-main">{{summary.locationText}}</view>
        <view class="location-sub">
          入库时间 {{inventory.inStockTimeText || '-'}}
        </view>
        <view class="location-grid">
          <view class="location-item">
            <text class="meta-label">侧位</text>
            <text class="meta-value">{{inventory.side || '-'}}</text>
          </view>
          <view class="location-item">
            <text class="meta-label">排号</text>
            <text class="meta-value">{{inventory.rowNumber != null ? inventory.rowNumber : '-'}}</text>
          </view>
          <view class="location-item">
            <text class="meta-label">层号</text>
            <text class="meta-value">{{inventory.layer != null ? inventory.layer : '-'}}</text>
          </view>
          <view class="location-item">
            <text class="meta-label">数量</text>
            <text class="meta-value">{{inventory.quantity != null ? inventory.quantity : '-'}} {{inventory.unit ? '件' : '板'}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="light-card empty-card">
        <view class="card-title">当前无库位信息</view>
        <view class="card-desc">{{summary.locationHint}}</view>
      </view>

      <view class="section-title">当前任务</view>
      <view wx:if="{{readonlyStageNotice}}" class="light-card empty-card">
        <view class="card-title">{{pallet.statusLabel}}</view>
        <view class="card-desc">{{readonlyStageNotice}}</view>
      </view>
      <view wx:elif="{{pendingTasks.length}}">
        <task-card
          wx:for="{{pendingTasks}}"
          wx:key="taskId"
          task="{{item}}"
          showActions="{{true}}"
          bind:tapTask="onTapTask"
          bind:confirmTask="onConfirmTask"
          bind:cancelTask="onCancelTask"
        />
      </view>
      <view wx:else class="light-card empty-card">
        <view class="card-title">当前无待处理任务</view>
        <view class="card-desc">该二维码目前没有需要立即处理的现场任务。</view>
      </view>
    </block>

    <block wx:if="{{activeTab === 'assay'}}">
      <view wx:if="{{assay}}" class="assay-card">
        <view class="card-head">
          <view class="card-title">化验结论</view>
          <status-tag label="{{assayResult.label}}" type="{{assayResult.type}}" />
        </view>
        <view class="assay-meta-grid">
          <view class="assay-meta-item">
            <text class="meta-label">采样日期</text>
            <text class="meta-value">{{assay.sampleDate || '-'}}</text>
          </view>
          <view class="assay-meta-item">
            <text class="meta-label">化验员</text>
            <text class="meta-value">{{assay.testerName || '-'}}</text>
          </view>
          <view class="assay-meta-item">
            <text class="meta-label">产品</text>
            <text class="meta-value">{{assay.productName || pallet.productName || '-'}}</text>
          </view>
          <view class="assay-meta-item">
            <text class="meta-label">录入时间</text>
            <text class="meta-value">{{assay.createdAtText || '-'}}</text>
          </view>
        </view>
        <view class="standard-pill">采用标准：{{assay.appliedStandardText}}</view>
        <view class="card-desc">{{assay.judgeMessage || assay.resolveMessage || '系统未返回额外说明。'}}</view>
        <view class="assay-summary-grid">
          <view class="assay-summary-item">
            <text class="meta-label">满足标准</text>
            <text class="meta-value">{{assay.matchedStandardsText}}</text>
          </view>
          <view class="assay-summary-item">
            <text class="meta-label">不达标项</text>
            <text class="meta-value">{{assay.failedMetricCount || 0}} 项</text>
          </view>
        </view>
        <view wx:if="{{assayDetailId}}" class="assay-link" bindtap="openAssayDetail">查看完整化验详情</view>
      </view>
      <view wx:if="{{assay}}" class="metric-list">
        <view wx:for="{{assayMetrics}}" wx:key="key" class="metric-row">
          <view>
            <view class="metric-name">{{item.label}}</view>
            <view class="metric-range">{{item.standardText}}</view>
            <view wx:if="{{item.reasonText}}" class="metric-reason">{{item.reasonText}}</view>
          </view>
          <view class="metric-side">
            <view class="metric-value">{{item.valueText}}</view>
            <status-tag label="{{item.statusText}}" type="{{item.statusType}}" />
          </view>
        </view>
      </view>
      <view wx:else class="light-card empty-card">
        <view class="card-title">{{assayResolveMessage || '暂无化验数据'}}</view>
        <view class="card-desc">{{assayResolveMessage ? '该二维码未形成可展示的正式化验记录。' : '系统没有找到该二维码当前轮次关联的化验记录。'}}</view>
      </view>
    </block>

    <block wx:if="{{activeTab === 'flow'}}">
      <view wx:if="{{flowGroups.length}}" class="timeline-card">
        <view wx:for="{{flowGroups}}" wx:key="date" wx:for-item="group" class="flow-date-group">
          <view class="flow-date">{{group.date}}</view>
          <view wx:for="{{group.items}}" wx:key="id" wx:for-item="item" class="flow-item">
            <view class="flow-rail">
              <view class="flow-icon {{item.operationTypeTag}}">
                <image class="flow-icon-img" src="{{item.iconSrc}}" mode="aspectFit"></image>
              </view>
              <view wx:if="{{!item.isLast}}" class="line"></view>
            </view>
            <view class="flow-card">
              <view class="flow-head">
                <text class="flow-title">{{item.operationLabel}}</text>
                <text class="flow-time">{{item.operationTimeText}}</text>
              </view>
              <view class="flow-meta">
                <image class="flow-mini-icon" src="/assets/icons-line/icon-user.svg" mode="aspectFit"></image>
                <text>{{item.operatorName || '系统'}}</text>
              </view>
              <view wx:if="{{item.hasLocation}}" class="flow-location">
                <view wx:if="{{item.locationMode === 'route'}}" class="location-route">
                  <view class="location-node">
                    <view class="location-node-head">
                      <image class="location-node-icon" src="/assets/icons-line/icon-location.svg" mode="aspectFit"></image>
                      <text class="location-label">{{item.locationRoutes[0].action}}</text>
                    </view>
                    <view class="location-text">{{item.locationRoutes[0].text}}</view>
                  </view>
                  <view class="location-arrow">
                    <image class="location-arrow-icon" src="/assets/icons-line/flow-arrow.svg" mode="aspectFit"></image>
                  </view>
                  <view class="location-node">
                    <view class="location-node-head">
                      <image class="location-node-icon" src="/assets/icons-line/icon-location.svg" mode="aspectFit"></image>
                      <text class="location-label">{{item.locationRoutes[1].action}}</text>
                    </view>
                    <view class="location-text">{{item.locationRoutes[1].text}}</view>
                  </view>
                </view>
                <block wx:else>
                  <view wx:for="{{item.locationRoutes}}" wx:key="key" wx:for-item="route" class="location-single">
                    <view class="location-node-head location-single-head">
                      <image class="location-node-icon" src="/assets/icons-line/icon-location.svg" mode="aspectFit"></image>
                      <text class="location-action {{item.operationTypeTag}}">{{route.action}}</text>
                    </view>
                    <view class="location-copy">
                      <view class="location-text">{{route.text}}</view>
                      <view wx:if="{{route.suffix}}" class="location-suffix">{{route.suffix}}</view>
                    </view>
                  </view>
                </block>
              </view>
              <view wx:if="{{item.flowExtras.length}}" class="flow-extra">
                <text wx:for="{{item.flowExtras}}" wx:key="*this" class="flow-extra-item">{{item}}</text>
              </view>
              <view wx:if="{{item.remarkText}}" class="flow-remark">
                <image class="flow-mini-icon remark-icon" src="/assets/icons-line/icon-remark.svg" mode="aspectFit"></image>
                <text>{{item.remarkText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="light-card empty-card">
        <view class="card-title">暂无流转记录</view>
        <view class="card-desc">该二维码当前没有可展示的生命周期事件。</view>
      </view>
    </block>
  </block>

  <bottom-action-bar actions="{{actions}}" bind:action="onAction" />

  <view wx:if="{{confirmVisible}}" class="modal-layer" catchtouchmove="noop">
    <view class="modal-mask" bindtap="closeConfirm" catchtouchmove="noop"></view>
    <view class="modal-card" catchtouchmove="noop">
      <view class="modal-title">处理待入库任务</view>
      <view class="modal-code">共 {{confirmTargetCount}} 个待处理二维码</view>
      <view class="field">
        <text class="label">入库库位</text>
        <input class="input" placeholder="请输入库位名称" value="{{confirmForm.warehouseName}}" data-field="warehouseName" bindinput="onConfirmInput" />
      </view>
      <view class="field">
        <text class="label">入库日期</text>
        <picker mode="date" value="{{confirmForm.entryDate}}" data-field="entryDate" bindchange="onConfirmInput">
          <view class="picker">{{confirmForm.entryDate}}</view>
        </picker>
      </view>
      <view class="field two">
        <view>
          <text class="label">优先侧</text>
          <picker mode="selector" range="{{['左', '右']}}" bindchange="onSideChange">
            <view class="picker">{{confirmForm.side}}</view>
          </picker>
        </view>
        <view>
          <text class="label">单位</text>
          <picker mode="selector" range="{{['板', '件']}}" bindchange="onUnitChange">
            <view class="picker">{{confirmForm.unit === '1' ? '件' : '板'}}</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <text class="label">数量</text>
        <input class="input {{confirmForm.unit === '0' ? 'disabled-input' : ''}}" type="number" value="{{confirmForm.quantity}}" data-field="quantity" bindinput="onConfirmInput" disabled="{{confirmForm.unit === '0'}}" />
      </view>
      <view class="modal-actions">
        <button class="plain" bindtap="closeConfirm">取消</button>
        <button class="primary" bindtap="submitConfirmIn">确认入库</button>
      </view>
    </view>
  </view>
</page-shell>

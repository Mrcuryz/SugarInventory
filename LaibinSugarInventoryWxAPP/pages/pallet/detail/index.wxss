.loading-card,
.grid-card,
.light-card,
.assay-card,
.timeline-card,
.metric-list {
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(23, 32, 51, 0.06);
}

.loading-card {
  font-size: 27rpx;
  color: #647089;
}

.detail-tabs {
  display: flex;
  gap: 10rpx;
  margin: 20rpx 0 8rpx;
  padding: 8rpx;
  border-radius: 8rpx;
  background: #edf2f7;
}

.detail-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #526072;
}

.detail-tab.active {
  color: #246bfe;
  background: #ffffff;
}

.grid-card,
.location-grid,
.assay-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.meta-item,
.location-item,
.assay-meta-item {
  padding: 20rpx;
  border-radius: 8rpx;
  background: #f7f9fc;
}

.meta-label {
  display: block;
  font-size: 22rpx;
  color: #647089;
}

.meta-value {
  display: block;
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #172033;
  word-break: break-all;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #172033;
}

.card-desc,
.location-sub,
.metric-range,
.flow-meta,
.flow-remark {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #647089;
}

.location-card,
.assay-card,
.timeline-card {
  margin-bottom: 4rpx;
}

.location-main {
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 800;
  color: #172033;
}

.location-grid,
.assay-meta-grid {
  margin-top: 18rpx;
}

.empty-card {
  padding-top: 22rpx;
  padding-bottom: 22rpx;
}

.standard-pill {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #246bfe;
  background: #eaf1ff;
}

.metric-list {
  margin-top: 16rpx;
}

.metric-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1f6;
}

.metric-row:first-child {
  padding-top: 0;
}

.metric-row:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.metric-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #172033;
}

.metric-value {
  font-size: 27rpx;
  font-weight: 800;
  color: #246bfe;
  text-align: right;
}

.flow-item {
  display: flex;
  gap: 18rpx;
}

.flow-item + .flow-item {
  margin-top: 4rpx;
}

.flow-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 24rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: #c5cfdb;
}

.dot.primary {
  background: #246bfe;
}

.dot.success {
  background: #107c41;
}

.dot.warning {
  background: #966600;
}

.dot.danger {
  background: #ba1a1a;
}

.dot.info {
  background: #7a869a;
}

.line {
  width: 2rpx;
  flex: 1;
  margin-top: 8rpx;
  background: #dbe4ef;
}

.flow-card {
  flex: 1;
  min-width: 0;
  padding-bottom: 28rpx;
}

.flow-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
}

.flow-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #172033;
}

.flow-location {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #2c3648;
}

.modal-layer {
  position: fixed;
  inset: 0;
  z-index: 60;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(23, 32, 51, 0.46);
}

.modal-card {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  max-height: 84vh;
  overflow: auto;
  padding: 30rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #172033;
}

.modal-code {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #647089;
}

.field {
  margin-top: 22rpx;
}

.field.two {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #647089;
}

.input,
.picker {
  min-height: 78rpx;
  line-height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8e0ec;
  border-radius: 8rpx;
  background: #fbfcfe;
  font-size: 27rpx;
  color: #172033;
}

.disabled-input {
  color: #9aa6b7;
  background: #f1f4f8;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.primary,
.plain {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  margin: 0;
  border-radius: 8rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.primary::after,
.plain::after {
  border: 0;
}

.primary {
  color: #ffffff;
  background: #246bfe;
}

.plain {
  color: #246bfe;
  background: #eaf1ff;
}

.container {
  padding: 20rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
}

/* 搜索栏样式 */
.search-bar {
  background-color: #ffffff;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-top: 1rpx;
  margin-right: 5px;
  margin-left: 5px;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.search-item {
  display: flex;
  align-items: center;
  gap: 10px;
}

.search input, .search-item .picker-date{
  flex: 1;
  height: 64rpx;
  width: 64px;
  border: 1rpx solid #dcdfe6;
  border-radius: 4rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  line-height: 64rpx;
}

.picker-mesh{
  flex: 1;
  height: 64rpx;
  width: auto;
  min-width: 88px;
  border: 1rpx solid #dcdfe6;
  border-radius: 4rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  line-height: 64rpx;
}

.search-product {
  width: 30px;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666666;
}

.search-item input, .search-item .picker-value {
  flex: 1;
  height: 64rpx;
  width: 100px;
  border: 1rpx solid #dcdfe6;
  border-radius: 4rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  line-height: 64rpx;
}

.search-btn, .qualified-btn {
  height: 70rpx;
  line-height: 70rpx;
  font-size: 28rpx;
  margin-top: 1rpx;
}

.search-btn {
  background-color: #1890ff;
  color: #ffffff;
}

.qualified-btn {
  background-color: #f0f0f0;
  color: #666666;
}

/* 库位卡片样式 */
.warehouse-list {
  background-color: #eeeeee;
  width: 96%;
  display: flex;
  flex-direction: column;
  margin-right: 25px;
  margin-left: 20px;
  gap: 20rpx;
  border-radius: 50rpx;
}

.warehouse-card {
  background-color: #ffffff;
  border-radius: 8rpx;
  width: 90%;
  gap: 10px;
  margin-top: 5px;
  margin-bottom: 10px;
  margin-left: 5px;
  margin-right: 15px;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.warehouse-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #303133;
}

.status-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-green {
  color: #52c41a;
}

.status-gray {
  color: #909399;
}

.status-orange {
  color: #faad14;
}

.status-black {
  color: #303133;
}

.status-red {
  color: #ff4d4f;
}

.tab-bar {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-bottom: 4rpx solid #ddd;
  font-size: 30rpx;
  color: #666;
}

.tab-item.active {
  border-bottom-color: #1890ff;
  color: #1890ff;
  font-weight: bold;
}

.capacity-container {
  margin-bottom: 20rpx;
}

.capacity-bar {
  height: 16rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.capacity-progress {
  height: 100%;
  transition: width 0.3s;
}

.capacity-progress.normal {
  background-color: #52c41a;
}

.capacity-progress.warning {
  background-color: #faad14;
}

.capacity-progress.danger {
  background-color: #ff4d4f;
}

.capacity-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #909399;
}

.card-meta {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 20rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
}

.detail-btn, .outbound-btn {
  font-size: 24rpx;
  min-width: 160rpx;
  background-color: rgb(0, 153, 255);
  color: rgb(255, 255, 255);
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  height: 400px;
  color: #909399;
  gap: 20rpx;
}

/* 分页样式 */
.pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #606266;
}

.page-controls {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.page-text {
  min-width: 60rpx;
  text-align: center;
}

/* 模态框样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.3s;
}

.modal.show {
  visibility: visible;
  opacity: 1;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 16rpx 16rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s;
  overflow: hidden;
  max-height: 80%;
  display: flex;
  flex-direction: column;
}

.modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #ebeef5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #303133;
}

.modal-close {
  font-size: 40rpx;
  color: #909399;
  line-height: 1;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

.modal-footer {
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  border-top: 1rpx solid #ebeef5;
}

/* 详情列表样式 */
.detail-list {
  width: 95%;
}

.detail-header {
  display: flex;
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #606266;
  border-bottom: 2rpx solid #ebeef5;
}

.detail-item {
  display: flex;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #606266;
  border-bottom: 1rpx solid #ebeef5;
}

.detail-item-2row {
  padding: 24rpx;
  margin: 16rpx 0;
  border-radius: 12rpx;
  background-color: #f8f8f8;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.04);
  border-bottom: 1rpx solid #ebeef5;
  font-size: 30rpx;
  color: #303133;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  white-space: nowrap;
}

.detail-item-2row .row {
  width: 90%;
  display: flex;
  flex-wrap: wrap;
  line-height: 1.8;
  justify-content: space-between;
}


.detail-item-2row .value {
  color: #303133;
  min-width: 46%;
  margin-right: 16rpx;
  overflow: hidden;
  white-space: nowrap;
}

.col {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col.product {
  flex: 1;
}

.col.date, .col.quantity, .col.weight {
  flex: 1;
  text-align: center;
}

.empty-detail {
  padding: 60rpx 0;
  text-align: center;
  color: #909399;
}

.detail-pagination {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  justify-content: flex-start;
}

/* 表单样式 */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #606266;
}

.form-label.required::after {
  content: '*';
  color: #ff4d4f;
  margin-left: 4rpx;
}

.form-group input {
  width: 100%;
  height: 70rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 4rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.error-msg {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
}

.side-options {
  display: flex;
  gap: 40rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

/* 加载样式 */
.loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.3s;
}

.loading.show {
  visibility: visible;
  opacity: 1;
}

.loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.8);
}

.loading-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.7);
  border-radius: 8rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-content text {
  color: #ffffff;
  font-size: 28rpx;
}
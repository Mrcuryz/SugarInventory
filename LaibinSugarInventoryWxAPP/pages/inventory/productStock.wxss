.app-container {
  padding: 20rpx;
  height: 100vh;
  box-sizing: border-box;
}

.main-content {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx 0 rgba(0, 0, 0, 0.1);
}

.search-form {
  margin-bottom: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
}

.form-input {
  flex: 1;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  padding: 10rpx 15rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.search-btn {
  width: 120rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 28rpx;
}

.tabs-header {
  display: flex;
  border-bottom: 1rpx solid #e4e7ed;
}

.tab-item {
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #303133;
  position: relative;
  cursor: pointer;
}

.tab-item.active {
  color: #409eff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 4rpx;
  background-color: #409eff;
}

.table-container {
  height: calc(100vh - 300rpx);
}

.table {
  width: 100%;
}

.table-header, .table-row {
  display: flex;
  border-bottom: 1rpx solid #ebeef5;
}

.table-header {
  background-color: #f5f7fa;
  font-weight: bold;
}

.table-col {
  padding: 20rpx;
  font-size: 26rpx;
  text-align: center;
}

.tag {
  display: inline-block;
  padding: 6rpx 12rpx;
  background-color: #ecf5ff;
  color: #409eff;
  border-radius: 4rpx;
  font-size: 24rpx;
}
.guide-layout {
  display: flex;
  gap: 18rpx;
  min-height: calc(100vh - 240rpx);
}

.toc-pane {
  width: 220rpx;
  flex-shrink: 0;
  border: 1rpx solid #e7edf5;
  border-radius: 24rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.guide-layout.is-collapsed .toc-pane {
  width: 116rpx;
}

.content-pane {
  flex: 1;
  min-width: 0;
}

.toc-toolbar {
  position: sticky;
  top: 0;
  z-index: 2;
  padding: 18rpx 14rpx 10rpx;
  background: #f5f7fb;
}

.toc-toggle-btn {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  border-radius: 16rpx;
  background: #ffffff;
  color: #246bfe;
  font-size: 24rpx;
  font-weight: 700;
  border: 1rpx solid #d8e3ff;
}

.toc-toggle-btn::after,
.action-btn::after,
.chapter-btn::after {
  border: 0;
}

.toc-list {
  padding: 8rpx 12rpx 18rpx;
}

.toc-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 12rpx;
  border-radius: 18rpx;
  color: #6a768f;
}

.toc-item.active {
  background: #eaf1ff;
  color: #246bfe;
}

.toc-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: #246bfe;
}

.toc-index {
  width: 34rpx;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.toc-copy {
  flex: 1;
  min-width: 0;
}

.toc-short {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.toc-title {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #647089;
}

.section-hero,
.content-card {
  border: 1rpx solid #e7edf5;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  box-shadow: 0 12rpx 32rpx rgba(23, 32, 51, 0.065);
}

.section-hero {
  padding: 28rpx;
  border-color: rgba(36, 107, 254, 0.14);
  background:
    radial-gradient(circle at 94% 8%, rgba(36, 107, 254, 0.1), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #f7fbff 100%);
}

.section-badge {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eaf1ff;
  color: #246bfe;
  font-size: 22rpx;
  font-weight: 700;
}

.section-title {
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #172033;
}

.section-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #647089;
}

.content-card {
  margin-top: 18rpx;
  padding: 26rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #172033;
}

.card-copy {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #526072;
}

.card-steps {
  background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
  border-color: #dce9ff;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 18rpx;
}

.step-index {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 999rpx;
  background: #246bfe;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
}

.step-copy {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 1.65;
  color: #4b5870;
}

.card-notice {
  background: linear-gradient(180deg, #fffbee 0%, #ffffff 100%);
  border-color: #f5df9b;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 18rpx;
}

.notice-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: #f4b400;
  flex-shrink: 0;
}

.notice-copy {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.65;
  color: #5f4f18;
}

.card-faq {
  background: linear-gradient(180deg, #fff6f5 0%, #ffffff 100%);
  border-color: #f4d0cb;
}

.faq-item {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.88);
}

.faq-question {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #b42318;
}

.faq-answer {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #5d6678;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.action-btn {
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.primary-btn {
  background: #246bfe;
  color: #ffffff;
}

.secondary-btn {
  background: #eef3ff;
  color: #246bfe;
}

.is-disabled {
  background: #edf1f7;
  color: #98a2b3;
}

.permission-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #98a2b3;
}

.chapter-nav {
  display: flex;
  gap: 16rpx;
  margin: 18rpx 0 8rpx;
}

.chapter-btn {
  flex: 1;
  margin: 0;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 16rpx;
  background: #eef3ff;
  color: #246bfe;
  font-size: 26rpx;
  font-weight: 700;
}

.chapter-btn[disabled] {
  background: #edf1f7;
  color: #98a2b3;
}

.primary-next {
  background: #246bfe;
  color: #ffffff;
}

.filter-card,
.assay-card {
  padding: 26rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  box-shadow: 0 12rpx 32rpx rgba(23, 32, 51, 0.065);
}

.filter-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.filter-row,
.filter-actions,
.card-head,
.assay-meta,
.assay-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.filter-input,
.filter-picker {
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8e0ec;
  border-radius: 18rpx;
  background: #fbfcfe;
  font-size: 26rpx;
  color: #172033;
}

.filter-picker {
  flex: 1;
  display: flex;
  align-items: center;
}

.filter-picker.small {
  flex: 0 0 150rpx;
  justify-content: center;
  font-weight: 700;
}

.mini-btn {
  flex: 1;
  height: 74rpx;
  line-height: 74rpx;
  font-size: 26rpx;
}

.summary-line {
  margin: 28rpx 0 16rpx;
  font-size: 24rpx;
  color: #647089;
}

.assay-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.card-head {
  justify-content: space-between;
}

.product-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 31rpx;
  font-weight: 850;
  color: #172033;
}

.assay-meta {
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #526072;
}

.assay-line {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #7a869a;
}

.assay-line image {
  width: 26rpx;
  height: 26rpx;
}

.standard-card {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #f6f9fe;
}

.standard-label {
  font-size: 22rpx;
  color: #7a869a;
}

.standard-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #526072;
}

.card-link {
  margin-top: 18rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #246bfe;
}
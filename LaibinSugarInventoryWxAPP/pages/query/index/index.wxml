<page-shell>
  <page-header title="查询中心" subtitle="现场查询与追溯入口，支持二维码、库存、化验、库位等快速查询" />

  <view class="hero-card">
    <view class="hero-top">
      <view>
        <view class="hero-title-row">
          <view class="hero-icon">
            <image class="hero-icon-img" src="/assets/icons-line/icon-search.svg" mode="aspectFit"></image>
          </view>
          <view class="hero-title">二维码查询</view>
        </view>
        <view class="hero-desc">支持手动输入二维码编号，也支持直接扫码进入详情。</view>
      </view>
      <view class="hero-badges">
        <text class="hero-badge">手输</text>
        <text class="hero-badge">扫码</text>
        <text class="hero-badge">详情</text>
      </view>
    </view>
    <input class="query-input" placeholder="请输入二维码编号" value="{{code}}" bindinput="onInput" />
    <view class="hero-actions">
      <button class="scan-btn" bindtap="onScan">扫码查询</button>
      <button class="search-btn" loading="{{querying}}" disabled="{{querying}}" bindtap="submitQuery">查看详情</button>
    </view>
    <view class="hero-subactions">
      <text class="hero-link" bindtap="clearCode">清空输入</text>
      <text class="hero-tip">常用场景：单码查询、问题复核、现场补查</text>
    </view>
  </view>

  <view wx:if="{{queryState === 'loading'}}" class="state-card">
    <view class="state-title">正在核对二维码信息</view>
    <view class="state-desc">会先校验二维码编号是否有效，再进入详情页。</view>
  </view>

  <view wx:if="{{queryState === 'empty'}}" class="state-wrap">
    <empty-state icon="/assets/icons-line/icon-search.svg" title="未找到对应二维码" description="请核对二维码编号是否正确，或重新扫码一次。" />
  </view>

  <view wx:if="{{queryState === 'error'}}" class="state-wrap">
    <empty-state icon="/assets/icons-line/icon-search.svg" title="查询未完成" description="网络不稳定或接口未返回结果，请稍后重试。" />
  </view>

  <view class="section-title">查询入口</view>
  <view class="module-grid">
    <view wx:for="{{modules}}" wx:key="key" class="module-card" data-url="{{item.url}}" bindtap="openModule">
      <view class="module-head">
        <view class="module-icon">
          <image class="module-icon-img" src="{{item.icon}}" mode="aspectFit"></image>
        </view>
        <text class="module-arrow">›</text>
      </view>
      <view class="module-title">{{item.title}}</view>
      <view class="module-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="hint-card">
    <view class="hint-title">使用提示</view>
    <view wx:for="{{scenarioTips}}" wx:key="*this" class="hint-item">{{item}}</view>
  </view>

  <view wx:if="{{recentQueries.length}}" class="section-title">最近查询</view>
  <view wx:if="{{recentQueries.length}}" class="recent-list">
    <view wx:for="{{recentQueries}}" wx:key="code" class="recent-card" data-code="{{item.code}}" bindtap="openRecent">
      <view class="recent-code">{{item.code}}</view>
      <view class="recent-time">{{item.timeText}}</view>
    </view>
  </view>
</page-shell>

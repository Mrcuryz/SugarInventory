.hero-card,
.module-card,
.hint-card,
.state-card {
  padding: 28rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  box-shadow: 0 12rpx 32rpx rgba(23, 32, 51, 0.065);
}

.hero-card {
  border-color: rgba(36, 107, 254, 0.16);
  background:
    radial-gradient(circle at 92% 8%, rgba(36, 107, 254, 0.12), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #f7fbff 100%);
}

.hero-top,
.module-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-title,
.module-title,
.hint-title,
.state-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #172033;
}

.hero-title-row,
.module-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.hero-icon,
.module-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #eaf1ff;
}

.hero-icon {
  width: 52rpx;
  height: 52rpx;
}

.module-icon {
  width: 48rpx;
  height: 48rpx;
}

.hero-icon-img,
.module-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.hero-title,
.module-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-desc,
.module-desc,
.state-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #647089;
}

.hero-badges {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.hero-badge,
.module-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-badge {
  color: #246bfe;
  background: #eaf1ff;
}

.module-tag {
  flex-shrink: 0;
  color: #526072;
  background: #eef2f6;
}

.query-input {
  width: 100%;
  height: 82rpx;
  margin-top: 24rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8e0ec;
  border-radius: 18rpx;
  background: #fbfcfe;
  font-size: 28rpx;
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.hero-subactions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.hero-link {
  font-size: 24rpx;
  font-weight: 700;
  color: #246bfe;
}

.hero-tip {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 23rpx;
  color: #647089;
}

.scan-btn,
.search-btn {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  margin: 0;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.scan-btn::after,
.search-btn::after {
  border: 0;
}

.scan-btn {
  color: #246bfe;
  background: #eaf1ff;
}

.search-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #246bfe, #165dff);
  box-shadow: 0 14rpx 28rpx rgba(36, 107, 254, 0.2);
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.hint-card,
.state-card,
.state-wrap {
  margin-top: 22rpx;
}

.hint-item {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #526072;
}

.module-card {
  min-height: 176rpx;
}

.module-head {
  align-items: center;
}

.module-title {
  margin-top: 16rpx;
  font-size: 28rpx;
}

.module-desc {
  display: -webkit-box;
  min-height: 72rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-size: 23rpx;
}

.module-arrow {
  font-size: 38rpx;
  line-height: 1;
  color: #9aa6b7;
}

.hint-card {
  background: #f7f9fd;
  box-shadow: none;
}

.hint-title {
  font-size: 28rpx;
}

.hint-item {
  position: relative;
  padding-left: 22rpx;
}

.hint-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 17rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #8fa1bd;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.recent-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(23, 32, 51, 0.055);
}

.recent-code {
  font-size: 28rpx;
  font-weight: 800;
  color: #172033;
  letter-spacing: 0.5rpx;
}

.recent-time {
  flex-shrink: 0;
  font-size: 23rpx;
  color: #7a869a;
}

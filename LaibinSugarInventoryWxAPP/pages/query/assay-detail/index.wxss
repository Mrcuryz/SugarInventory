.summary-card,
.metric-card,
.standard-card,
.judge-card {
  padding: 26rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  box-shadow: 0 12rpx 32rpx rgba(23, 32, 51, 0.065);
}

.summary-head,
.metric-card,
.judge-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.judge-card {
  align-items: flex-start;
  justify-content: flex-start;
  margin-top: 22rpx;
  border-color: rgba(36, 107, 254, 0.16);
  background: #f7fbff;
}

.judge-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #eaf1ff;
}

.judge-icon image {
  width: 32rpx;
  height: 32rpx;
}

.judge-body {
  flex: 1;
  min-width: 0;
}

.judge-title {
  font-size: 29rpx;
  font-weight: 850;
  color: #172033;
}

.judge-desc,
.metric-range {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #7a869a;
}

.product-title {
  font-size: 34rpx;
  font-weight: 850;
  color: #172033;
}

.summary-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #647089;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.info-item {
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f6f9fe;
}

.info-label,
.metric-hint {
  font-size: 22rpx;
  color: #7a869a;
}

.info-value {
  margin-top: 8rpx;
  font-size: 25rpx;
  font-weight: 750;
  color: #172033;
}

.metric-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.metric-main {
  flex: 1;
  min-width: 0;
}

.metric-label {
  font-size: 28rpx;
  font-weight: 800;
  color: #172033;
}

.metric-hint {
  margin-top: 8rpx;
}

.metric-value {
  font-size: 30rpx;
  font-weight: 850;
  color: #246bfe;
}

.metric-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.standard-title {
  font-size: 28rpx;
  font-weight: 850;
  color: #172033;
}

.standard-text {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f6f9fe;
  font-size: 25rpx;
  line-height: 1.5;
  color: #526072;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #f7f7f7;
}

.title {
  display: flex;
  align-items: center;
  font-size: 50rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.usage-text {
  font-size: 30rpx;
  color: #666;
  margin-left: 20px;
  line-height: 1.6;
  margin-right: 20px;
}

.logo {
  width: 800rpx;
  height: 600rpx;
  margin-bottom: 120rpx;
}

.tip {
  font-size: 28rpx;
  color: #666;
  margin-top: 20rpx;
}

.login {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 1px;
  margin-top: 4px;
  margin-right: 2px;
}

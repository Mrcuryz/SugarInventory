<page-meta page-style="{{showModal ? 'overflow: hidden; height: 100vh;' : ''}}"></page-meta>
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="产品名称" bindinput="onSearchInput" data-field="productName" />
    <input class="search-input" placeholder="库位名称" bindinput="onSearchInput" data-field="warehouseName" />
    <input class="search-input" placeholder="操作员姓名" bindinput="onSearchInput" data-field="operatorName" />
  </view>

  <view class="date-filter">
    <picker mode="date" bindchange="onDateChange" data-field="startDate">
      <view class="date-picker">
        {{queryParams.startDate ? queryParams.startDate : "起始日期"}}
      </view>
    </picker>
    <text>~</text>
    <picker mode="date" bindchange="onDateChange" data-field="endDate">
      <view class="date-picker">
        {{queryParams.endDate ? queryParams.endDate : "结束日期"}}
      </view>
    </picker>
    <button class="reset-btn" bindtap="resetFilters">
      <image src="/assets/icons/reset.png"></image>
    </button>
  </view>

  <!-- 成品列表 -->
  <view class="semi-product-list">
    <block wx:for="{{productRecords}}" wx:key="id">
      <view class="semi-product-card">
        <!-- 头部基础信息 -->
        <view class="semi-product-info">
          <view>ID: <text class="bold">{{item.id}}</text></view>
          <view>产品名称: <text class="bold">{{item.productName}}</text></view>
          <view>库位名称: <text class="bold">{{item.warehouseName}}</text></view>
          <view>入库日期: <text class="bold">{{item.operationDate}}</text></view>
        </view>

        <!-- 指标信息区域 -->
        <view class="indicator">
          <view class="indicator-row">
            <text>入库数量: {{item.quantity != null ? item.quantity + '板' : '无数据'}}</text>
            <text>总重量: {{item.totalWeight != null ? item.totalWeight + 'kg' : '无数据'}}</text>
          </view>
          <view class="indicator-row">
            <text>操作员: {{item.operator}}</text>
            <text>使用筛网: {{item.meshName != null ? item.meshName : '无数据'}}</text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="action-buttons">
          <button class="labData-btn" wx:if="{{item.labData && item.labData.length && role != 'STAFF'}}" bindtap="toggleLabData" data-index="{{index}}">
            {{item.showLabData ? '隐藏化验数据' : '查看化验数据'}}
          </button>
          <button class="semi-product-btn" wx:if="{{item.semiProductRecords && item.semiProductRecords.length > 0}}" bindtap="toggleSemiProductRecords" data-index="{{index}}">
            {{item.showSemiProductRecords ? '隐藏相关半成品' : '查看相关半成品'}}
          </button>
        </view>

        <!-- 化验数据 -->
        <view wx:if="{{item.showLabData}}" class="labData-data">
          <block wx:for="{{item.labData}}" wx:key="id">
            <view class="labData-item">
              <view><text class="bold">ID：</text>{{item.assayId}}</view>
              <view><text class="bold">采样日期：</text>{{item.sampleDate || '暂无数据'}}</view>
              <view><text class="bold">色值(IU)：</text>{{item.colorValue != null ? item.colorValue : '暂无数据'}}</view>
              <view><text class="bold">还原糖分：</text>{{item.reducingSugar != null ? item.reducingSugar + 'g/100g' : '暂无数据'}}</view>
              <view><text class="bold">pH值：</text>{{item.phValue != null ? item.phValue : '暂无数据'}}</view>
              <view><text class="bold">干燥失重：</text>{{item.dryWeight != null ? item.dryWeight + 'g/100g' : '暂无数据'}}</view>
              <view><text class="bold">电导灰分：</text>{{item.conductivityAsh != null ? item.conductivityAsh + 'g/100g' : '暂无数据'}}</view>
              <view><text class="bold">蔗糖分：</text>{{item.sucrose != null ? item.sucrose + 'g/100g' : '暂无数据'}}</view>
              <view><text class="bold">不溶于水杂质：</text>{{item.insolubleImpurity != null ? item.insolubleImpurity + 'mg/kg' : '暂无数据'}}</view>
              <view><text class="bold">符合标准：</text>{{item.qualifiedStandardsText}}</view>
              <view><text class="bold">检验：</text>{{item.isQualified || '暂无数据'}}</view>
              <view><text class="bold">化验员：</text>{{item.testerName || '暂无数据'}}</view>
            </view>
          </block>
        </view>
        <view wx:if="{{item.showSemiProductRecords}}" class="labData-data">
          <text class="bold">相关半成品记录</text>
          <block wx:for="{{item.semiProductRecords}}" wx:key="semiProductId">
            <view class="labData-item">
              <view>
                <text>半成品名称: {{item.productName}}</text>
              </view>
              <view>
                <text>生产日期: {{item.productionDate}}</text>
              </view>
              <view>
                <text>使用数量: {{item.quantity}} {{item.unit == '0' ? '板' : '件'}}</text>
              </view>
              <view wx:if="{{item.useAssay}}" class="used-assay">
                <text>已套用该半成品的化验数据</text>
              </view>
            </view>
          </block>
        </view>
      </view>
    </block>
  </view>

  <!-- 分页组件 -->
  <view class="pagination">
    <view class="page-control">
      <div class="arrow-btn" bindtap="prevPage" disabled="{{currentPage === 1}}">
        <image src="/assets/icons/arrow-left.png"></image>
      </div>

      <input class="page-input" type="number" value="{{currentPage}}" bindinput="onPageInput" min="1" max="{{totalPages}}" />

      <text class="total">/ {{totalPages}}</text>

      <div class="arrow-btn" bindtap="nextPage" disabled="{{currentPage === totalPages}}">
        <image src="/assets/icons/arrow-right.png"></image>
      </div>
    </view>
  </view>

  <!-- 悬浮新增按钮 -->
  <view class="floating-button" bindtap="showAddRecordModal">
    <image class="icon" src="/assets/icons/add.png"></image>
  </view>

  <!-- 背景遮罩层 -->
  <view wx:if="{{showModal}}" class="modal-overlay" bindtap="hideModal" catchtouchmove="noop"></view>

  <!-- 弹出表单 -->
  <view wx:if="{{showModal}}" class="modal" catchtouchmove="noop">
    <view class="modal-header">
      <view class="tabs">
      <view class="tab {{returnInstockFlag === 0 ? 'active' : ''}}" 
        bindtap="switchTab" data-tab="0">
        成品入库
      </view>
      <view class="tab {{returnInstockFlag === 1 ? 'active' : ''}}" 
        bindtap="switchTab" data-tab="1">
        退货入库
      </view>
    </view>
      <image src="/assets/icons/close.png" class="close-icon" bindtap="hideModal"></image>
    </view>

    <scroll-view class="modal-body" scroll-y>
      <view class="form-item">
        <text class="label">库位名称</text>
        <input class="input" placeholder="输入库位名称" bindinput="onInputChange" data-field="warehouseName" value="{{currentRecord.warehouseName}}" />
      </view>
      <view class="form-item">
        <text class="label">产品名称</text>
        <picker mode="multiSelector" range="{{finishedProductOptions}}" value="{{pickerIndexes}}" bindcolumnchange="onFinishedProductPickerChange" bindchange="onFinishedProductPickerConfirm">
          <input class="input-1" placeholder="请选择产品" value="{{currentRecord.productName}}" disabled />
        </picker>
      </view>
      <view class="form-item">
        <text class="label">入库日期</text>
        <view class="row">
          <picker mode="date" bindchange="onEntryDateChange">
            <view class="picker-date" style="width: 120%">
              {{ currentRecord.entryDate || '请选择入库日期' }}
            </view>
          </picker>
          <view wx:if="{{hasAssay !== null}}" class="assay-status">
            <text style="color: {{hasAssay ? 'green' : 'red'}};">
              {{hasAssay ? '✓ 已化验' : '× 未化验'}}
            </text>
          </view>
        </view>
      </view>
      <view class="form-item">
        <text class="label">入库数量</text>
        <view class="group-input">
          <input class="input" type="number" placeholder="输入入库数量" bindinput="onInputChange" data-field="quantity" value="{{currentRecord.quantity}}" />
          <picker mode="selector" range="{{['板', '件']}}"  value="{{unit}}" 
            bindchange="onUnitChange" class="custom-select"
          >
            <view class="picker-content">
              {{unit == 0 ? '板' : '件'}}
            </view>
          </picker>
        </view>
      </view>
      <view class="form-item">
        <text class="label">入库顺序</text>
        <picker mode="selector" range="{{sideOptions}}" bindchange="onsideChange">
          <view class="picker">{{currentRecord.side || "请选择入库顺序"}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="label">筛网</text>
        <picker mode="selector" range="{{screenMeshOptions}}" bindchange="onScreenMeshChange" value="selectedScreenMeshIndex">
          <view class="picker">{{screenMeshOptions[selectedScreenMeshIndex] || '请选择'}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="label">相关半成品记录：</text>
        <view>
          <button bindtap="addSemiProductRecord" class="add-btn">新增半成品记录</button>
        </view>
        <view class="form-item" wx:for="{{currentRecord.semiRecords}}" wx:key="index" wx:for-item="record" wx:for-index="idx">
          <view class="form-item">
            <text class="label">半成品记录 {{idx + 1}}</text>
            <picker mode="multiSelector" range="{{semiProductOptions}}" bindcolumnchange="onSemiProductPickerChange" bindchange="onSemiProductPickerConfirm" data-index="{{idx}}">
              <input class="input" placeholder="请选择产品" value="{{currentRecord.semiRecords[idx].productName}}" disabled />
            </picker>
          </view>
          <view class="form-item">
            <text class="label">生产日期</text>
            <picker mode="date" bindchange="onProductionDateChange" data-index="{{idx}}">
              <view class="picker">{{currentRecord.semiRecords[idx].productionDate || '请选择日期'}}</view>
            </picker>
          </view>
          <view class="form-item">
            <text class="label">{{returnInstockFlag == 0 ? '库位选择': '库位名称'}}</text>
            <picker mode="selector" wx:if="{{returnInstockFlag == 0}}" range="{{currentRecord.semiRecords[idx].productWarehouse}}" range-key="warehouseName" data-index="{{idx}}"
              bindchange="onInWarehouseNameChange">
              <input class="input" placeholder="请选择库位" value="{{currentRecord.semiRecords[idx].warehouseName}}" disabled />
            </picker>
            <input wx:if="{{returnInstockFlag == 1}}" class="input" placeholder="输入库位名称" bindinput="onReturnWarehouseNameChange" data-index="{{idx}}" value="{{currentRecord.semiRecords[idx].warehouseName}}" />
            <text class="error-msg" wx:if="{{inWarehouseNameError}}">{{inWarehouseNameError}}</text>
          </view>
          <view class="form-item">
            <text class="label">使用数量</text>
            <view class="group-input">
              <input class="input" placeholder="输入使用数量" bindinput="onSemiProductQuantityInput" data-index="{{idx}}" value="{{currentRecord.semiRecords[idx].quantity}}" />
              <picker mode="selector" range="{{['板', '件']}}"  value="{{currentRecord.semiRecords[idx].unit}}" bindchange="onSemiUnitChange" data-index="{{idx}}" class="custom-select"
              >
                <view class="picker-content">
                  {{currentRecord.semiRecords[idx].unit == 0 ? '板' : '件'}}
                </view>
              </picker>
            </view>
          </view>
          <view class="form-item">
            <text class="label">套用该半成品的化验数据</text>
            <switch checked="{{record.useAssay}}" bindchange="onUseAssayChange" data-index="{{idx}}" value="{{currentRecord.semiRecords[idx].useAssay}}" color="#07c160" />
          </view>
          <button bindtap="removeSemiProductRecord" data-index="{{idx}}" class="del-btn">删除</button>
          <!-- <text class="label">\n</text> -->
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{additionalStorage}}" class="storage-alert">
      <text>剩余入库数量：{{currentRecord.quantity}}板</text>
    </view>
    <view class="modal-footer">
      <button class="submit-btn" bindtap="submitRecord">提交</button>
    </view>
  </view>
</view>

.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.search-bar {
  width: 85%;
  box-sizing: border-box;
  background: #f2f2f2;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  border: none;
  background: transparent;
  outline: none;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: 10rpx;
}

.screen-mesh-list {
  display: flex;
  flex-direction: column;
  width: 80%;
  gap: 20rpx;
}

.screen-mesh-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.screen-mesh-card {
  background: white;
  padding: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.bold {
  font-weight: bold;
}

.action-buttons {
  margin-right: 30px;
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
}

.edit-btn {
  background: #FFC107;
  color: white;
}

.maintain-btn {
  background: #6C757D;
  color: white;
}

.delete-btn {
  background: #DC3545;
  color: white;
}

.floating-button {
  position: fixed;
  bottom: 100rpx; /* 适当上移，避免遮挡 */
  right: 40rpx; /* 适当调整位置 */
  width: 100rpx; /* 适当增大，提高可点击区域 */
  height: 100rpx;
  background: #007AFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2); /* 添加阴影，提高立体感 */
  transition: transform 0.2s ease-in-out;
}

.floating-button:hover {
  transform: scale(1.2); /* 悬停时放大，增加交互感 */
}

.floating-button image {
  width: 50rpx; /* 图标大小调整 */
  height: 50rpx;
  filter: drop-shadow(2rpx 2rpx 5rpx rgba(0, 0, 0, 0.3)); /* 轻微阴影，增强可见性 */
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal {
  position: fixed;
  bottom: 0;
  width: 90%;
  background: white;
  padding: 20rpx;
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 -4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.title {
  font-size: 50rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 20rpx;
  width: 95%;
}

.form-item text {
  display: block;
  font-size: 38rpx;
  margin-bottom: 8rpx;
}

.input, .picker {
  width: 100%;
  padding: 16rpx;
  border: 1px solid #ddd;
  border-radius: 20rpx;
  font-size: 36rpx;
}

/* 调整多行输入框样式 */
.multi-line {
  min-height: 100rpx; /* 初始最小高度 */
  padding: 16rpx;
  line-height: 1.5; /* 行高优化 */
  overflow: visible; /* 允许内容溢出可见 */
}

.submit-btn {
  width: 100%;
  background: #007aff;
  color: white;
  font-size: 40rpx;
  text-align: center;
  padding: 16rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
}

.status-container {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.account-card,
.menu-card,
.logout-card {
  padding: 28rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  box-shadow: 0 12rpx 32rpx rgba(23, 32, 51, 0.065);
}

.account-card {
  border-color: rgba(36, 107, 254, 0.14);
  background:
    radial-gradient(circle at 94% 8%, rgba(36, 107, 254, 0.12), transparent 30%),
    linear-gradient(135deg, #ffffff 0%, #f7fbff 100%);
}

.account-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  font-size: 38rpx;
  font-weight: 800;
  color: #172033;
}

.account-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #647089;
}

.account-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef8f2;
  color: #2f7d55;
  font-size: 22rpx;
  font-weight: 700;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.meta-card {
  padding: 20rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.78);
}

.meta-label {
  font-size: 22rpx;
  color: #647089;
}

.meta-value {
  margin-top: 10rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #172033;
  word-break: break-all;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.menu-title,
.logout-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #172033;
}

.menu-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.menu-icon {
  width: 38rpx;
  height: 38rpx;
}

.menu-desc,
.logout-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #647089;
}

.logout-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.logout-copy {
  flex: 1;
  min-width: 0;
}

.logout-btn {
  width: 180rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  border-radius: 18rpx;
  color: #d92d20;
  background: #fff1f1;
  font-size: 26rpx;
  font-weight: 700;
}

.logout-btn::after {
  border: 0;
}

<page-shell>
  <page-header title="我的" subtitle="账号信息、帮助入口与系统操作" />

  <view class="account-card">
    <view class="account-head">
      <view>
        <view class="name">{{userInfo.name || userInfo.username || '未识别账号'}}</view>
        <view class="account-desc">当前账号已接入现场扫码、任务处理与托盘查询能力。</view>
      </view>
      <view class="account-tag">在线</view>
    </view>
    <view class="meta-grid">
      <view wx:for="{{accountMeta}}" wx:key="label" class="meta-card">
        <view class="meta-label">{{item.label}}</view>
        <view class="meta-value">{{item.value}}</view>
      </view>
    </view>
  </view>

  <view class="section-title">常用入口</view>
  <view class="menu-list">
    <view wx:for="{{menus}}" wx:key="key" class="menu-card" data-key="{{item.key}}" bindtap="onMenuTap">
      <view class="menu-head">
        <image class="menu-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="menu-title">{{item.title}}</view>
      </view>
      <view class="menu-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="section-title">系统操作</view>
  <view class="logout-card">
    <view class="logout-copy">
      <view class="logout-title">退出当前账号</view>
      <view class="logout-desc">退出后会返回登录页，不影响后台已创建的任务与托盘记录。</view>
    </view>
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</page-shell>

.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  gap: 10rpx;
}

.search-bar-operator {
  width: 33%;
}

.search-input {
  flex: 1;
  border: 1px solid #ddd;
  border-radius: 10rpx;
  padding: 10rpx;
}

/* 日期筛选 */
.date-filter {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.date-picker {
  padding: 10rpx;
  border: 1px solid #ddd;
  border-radius: 10rpx;
}

.reset-btn {
  background: none;
  border: none;
}

.reset-btn image {
  width: 30rpx;
  height: 30rpx;
}

/* 数据列表 */
.semi-product-list {
  display: flex;
  flex-direction: column;
  width: 90%;
  gap: 20rpx;
}

.semi-product-card {
  background: #fff;
  border-radius: 12rpx;
  width: 95%;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,.1);
  padding: 20rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.semi-product-info, .indicator, .labData-data {
  margin-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.indicator-row {
  display: flex;
  margin-left: 5px;
  margin-right: 5px;
  justify-content: space-between;
}

.bold {
  font-weight: bold;
  color: #333;
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 15rpx;
  margin-top: 15rpx;
}

.edit-btn, .labData-btn {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
}

.labData-btn {
  background: #67C23A;
  color: #fff;
}

.labData-data {
  margin-top: 20rpx;
  padding: 15rpx;
  background: #f2f7f9;
  border-left: 8rpx solid #67C23A;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}


.labData-item {
  background: #def1e1;
  padding: 15rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  line-height: 1.8;
  font-size: 28rpx;
}

.labData-item .text {
  gap:10px;
  justify-content: space-between;
}

.labData-item:last-child {
  border-bottom: none;
}

.lab-data-info {
  font-size: 16px;
}

.indicator {
  font-size: 14px;
}

.bold {
  font-weight: bold;
}

.action-buttons {
  display: flex;
  gap: 10rpx;
}

.edit-btn {
  background: #007AFF;
  color: white;
}

.modal {
  width: 90%;
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1001;
}

.modal-header {
  position: relative;
  padding-bottom: 20rpx;
  border-bottom: 1px solid #eee;
}

.modal-header .close-icon {
  width: 30rpx;
  height: 30rpx;
  position: absolute;
  right: 10rpx;
  top: 10rpx;
}

.modal-body {
  max-height: 60vh;
  padding-top: 20rpx;
}

.modal-footer {
  padding-top: 20rpx;
  text-align: center;
}

.modal-overlay {
  position: fixed;
  left: 0; top: 0;
  width: 100%; height: 100%;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 1000;
}

.title {
  font-size: 50rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-item text {
  display: block;
  font-size: 38rpx;
  margin-bottom: 8rpx;
}

.input, .picker {
  width: 90%;
  padding: 16rpx;
  border: 1px solid #ddd;
  border-radius: 20rpx;
  font-size: 36rpx;
}

.indicator-group {
  margin-top:15px;
  display: grid;
  width: 93%;
  gap: 30px;
}

.label {
  font-size: 16px;
}

.required {
  color: rgb(255, 0, 0);
}

.submit-btn {
  width: 100%;
  background: #007aff;
  color: white;
  font-size: 40rpx;
  text-align: center;
  padding: 16rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
}

/* 分页 */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.page-btn {
  background: #6C757D;
  color: white;
}

/* 悬浮按钮 */
.floating-button {
  position: fixed;
  bottom: 100rpx; /* 适当上移，避免遮挡 */
  right: 40rpx; /* 适当调整位置 */
  width: 100rpx; /* 适当增大，提高可点击区域 */
  height: 100rpx;
  background: #007AFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2); /* 添加阴影，提高立体感 */
  transition: transform 0.2s ease-in-out;
}

.floating-button image {
  width: 50rpx;
  height: 50rpx;
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #f5f5f5;
}

.arrow-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease-in-out;
}

.arrow-btn image {
  width: 36rpx; 
  height: 36rpx; 
}

.page-control {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.page-input {
  width: 80rpx;
  text-align: center;
  border: 1px solid #ddd;
  border-radius: 8rpx;
  padding: 8rpx;
}

.size-picker {
  padding: 10rpx 20rpx;
  border: 1px solid #007AFF;
  border-radius: 8rpx;
  color: #007AFF;
}

.storage-alert {
  padding: 20rpx;
  background: #fffbe6;
  border-radius: 8rpx;
  margin-bottom: 30rpx;
  color: #faad14;
}

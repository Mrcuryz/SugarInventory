.container {
  padding: 20rpx;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  padding: 10rpx 20rpx;
  border-radius: 40rpx;
  margin-bottom: 20rpx;
  width: 70%;
}

.search-bar input {
  flex: 1;
  border: none;
  background: none;
  font-size: 28rpx;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.filter-button {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  border: 1px solid #ddd;
  padding: 12rpx 80rpx;
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
  position: relative;
}

.arrow-icon {
  width: 20rpx;
  height: 12rpx;
  margin-left: 20rpx;
  opacity: 1;
}

/* 重置按钮 */
.reset-button {
  width: 48rpx;
  height: 75rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reset-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 产品列表 */
.product-list {
  display: flex;
  width: 80%;
  flex-direction: column;
}

/* 产品卡片 */
.product-card {
  display: flex;
  width: 100%;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: white;
  box-shadow: 0px 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bold {
  font-size: 30rpx;
  font-weight: bold;
}

.desc {
  color: #777;
  font-size: 26rpx;
  margin: 10rpx 0;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  margin-top: 10rpx;
}

.edit-btn, .delete-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.edit-btn {
  background: #d9f7be;
  color: #52c41a;
}

.delete-btn {
  background: #ffd9d9;
  color: #ff4d4f;
}

.edit-btn image, .delete-btn image {
  width: 30rpx;
  height: 30rpx;
  margin-right: 6rpx;
}

/* 悬浮按钮 */
.floating-button {
  position: fixed;
  right: 40rpx;
  bottom: 100rpx;
  background: #007aff;
  color: white;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  box-shadow: 0px 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

.floating-button .icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

/* 模态框样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  background-color: #f8f8f8;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  line-height: 1;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.form-label.required::before {
  content: '*';
  color: #ff4d4f;
  margin-right: 6rpx;
}

.modal-body input,
.modal-body .picker-value {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  color: #222; /* 更深的字体颜色使文字更显眼 */
  background-color: #e0e0e0; /* 更亮的背景提升可读性 */
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1); /* 添加阴影 */
}

.picker-value {
  color: #333;
}

.modal-footer {
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  border-top: 1rpx solid #eee;
  background-color: #f8f8f8;
}

.modal-footer button {
  min-width: 200rpx;
  margin: 0;
  font-size: 28rpx;
}

.modal-footer button[type="default"] {
  color: #666;
  background: #fff;
  border: 1rpx solid #ddd;
}

.modal-footer button[type="primary"] {
  background-color: #1890ff;
}

/* 错误信息样式 */
.error-msg {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-top: 6rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-item text {
  display: block;
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.input, .picker {
  width: 100%;
  padding: 16rpx;
  border: 1px solid #ddd;
  border-radius: 10rpx;
  font-size: 36rpx;
}

.submit-btn {
  width: 100%;
  background: #007aff;
  color: white;
  font-size: 30rpx;
  text-align: center;
  padding: 16rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
}
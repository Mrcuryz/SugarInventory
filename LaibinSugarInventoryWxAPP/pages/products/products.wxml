<view class="container">
  <!-- 搜索框 -->
  <view class="search-bar">
    <input placeholder="请输入搜索内容" bindinput="onSearchInput" />
    <image class="search-icon" src="/assets/icons/search.png"></image>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <!-- 产品类型筛选 -->
    <picker mode="selector" range="{{productTypeOptions}}" bindchange="onPickerChange" data-field="selectedType">
      <view class="filter-button">
        <text>{{selectedType || "类型"}}</text>
        <image class="arrow-icon" src="/assets/icons/down-arrow.png"></image>
      </view>
    </picker>

    <!-- 状态筛选 -->
    <picker mode="selector" range="{{statusOptions}}" bindchange="onPickerChange" data-field="selectedStatus">
      <view class="filter-button">
        <text>{{selectedStatus || "状态"}}</text>
        <image class="arrow-icon" src="/assets/icons/down-arrow.png"></image>
      </view>
    </picker>
    <view class="reset-button" bindtap="resetFilters">
      <image class="reset-icon" src="/assets/icons/reset.png"></image>
    </view>
    <!-- 重置按钮 -->
  </view>

  <!-- 产品列表 -->
  <view class="product-list">
    <block wx:for="{{products}}" wx:key="id">
      <view class="product-card">
        <view class="product-info">
          <text class="bold">产品id: {{item.id}}</text>
          <text class="bold">产品名称: {{item.productName}}   <text wx:if="{{item.packagingMethod}}">  |  包装：{{item.packagingMethod}}</text>
          </text>
          <text>筛网: {{screenMeshNameMap[item.screenMeshId] || '未选择'}}</text>
          <text>{{item.weightPerPiece}}kg/件 | {{item.piecesPerPallet}}件/板 | 可堆积: {{item.canStack ? '是' : '否'}}</text>
          <view class="action-buttons">
            <view class="edit-btn" bindtap="editProduct" data-id="{{item.id}}">
              <image src="/assets/icons/edit.png"></image>
              <text>修改</text>
            </view>
            <view class="delete-btn" bindtap="deleteProduct" data-id="{{item.id}}">
              <image src="/assets/icons/delete.png"></image>
              <text>删除</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
  <!-- 悬浮新增按钮 -->
  <view class="floating-button" bindtap="showAddProductModal">
    <image class="icon" src="/assets/icons/add.png"></image>
    <text>新增产品</text>
  </view>

  <!-- 新增产品弹窗 -->
  <view class="modal {{showModal ? 'show' : ''}}">
    <view class="modal-mask" bindtap="hideModal" catchtouchmove="true"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">新增产品</text>
        <view class="modal-close" bindtap="hideModal">×</view>
      </view>

      <view class="modal-body">
        <view class="form-group">
          <text class="form-label required">产品名称</text>
          <input type="text" placeholder="请输入产品名称" bindinput="onInputChange" data-field="productName" value="{{newProduct.productName}}" />
        </view>

        <view class="form-group">
          <text class="form-label required">包装方式</text>
          <picker mode="selector" range="{{packagingMethodOptions}}" bindchange="onPickerChange" data-field="packagingMethod">
            <view class="picker-value">{{newProduct.packagingMethod || "请选择包装方式"}}</view>
          </picker>
        </view>

        <view class="form-group">
          <text class="form-label required">产品类型</text>
          <picker mode="selector" range="{{productTypeOptions}}" bindchange="onPickerChange" data-field="productType">
            <view class="picker-value">{{newProduct.productType || "请选择产品类型"}}</view>
          </picker>
        </view>

        <view class="form-group">
          <text class="form-label required">产品状态</text>
          <picker mode="selector" range="{{statusOptions}}" bindchange="onPickerChange" data-field="status">
            <view class="picker-value">{{newProduct.status || "请选择产品状态"}}</view>
          </picker>
        </view>

        <view class="form-group">
          <text class="form-label required">每件重量 (kg)</text>
          <input type="digit" placeholder="请输入每件重量" bindinput="onInputChange" data-field="weightPerPiece" value="{{newProduct.weightPerPiece}}" />
        </view>

        <view class="form-group">
          <text class="form-label required">每板数量 (件)</text>
          <input type="number" placeholder="请输入每板数量" bindinput="onInputChange" data-field="piecesPerPallet" value="{{newProduct.piecesPerPallet}}" />
        </view>

        <view class="form-group">
          <text class="form-label required">可堆积</text>
          <picker mode="selector" range="{{['是', '否']}}" bindchange="onPickerChange" data-field="canStack">
            <view class="picker-value">{{newProduct.canStack !== undefined ? (newProduct.canStack ? '是' : '否') : '请选择'}}</view>
          </picker>
        </view>
        <view class="form-group">
          <text class="form-label required">筛网</text>
          <picker
  mode="selector"
  range="{{screenMeshOptions}}"
  bindchange="onScreenMeshChange"
  value="{{selectedScreenMeshIndex}}"
>
  <view class="picker-value">
    {{screenMeshOptions[selectedScreenMeshIndex] || '请选择'}}
  </view>
</picker>
        </view>
      </view>

      <view class="modal-footer">
        <button type="default" bindtap="hideModal">取消</button>
        <button type="primary" bindtap="submitNewProduct">确认提交</button>
      </view>
    </view>
  </view>
</view>
/* edit-product.wxss */

.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  background-color: #f5f7fa;
}

.modal {
  width: 92%;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  padding: 40rpx 30rpx;
  margin: 20rpx auto;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 40rpx;
  text-align: center;
  display: block;
  position: relative;
  padding-bottom: 20rpx;
}

.title:after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 40%;
  right: 40%;
  height: 4rpx;
  background: #1890ff;
  border-radius: 2rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item text {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-item .required:after {
  content: '*';
  color: #ff4d4f;
  margin-left: 8rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid #e8e8e8;
  background-color: #e0e0e0; /* 更亮的背景提升可读性 */
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1); /* 添加阴影 */
}

.input:focus {
  border-color: #1890ff;
  background-color: #fff;
}

.picker {
  width: 100%;
  height: 80rpx;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid #e8e8e8;
  display: flex;
  align-items: center;
  position: relative;
  background-color: #e0e0e0; /* 更亮的背景提升可读性 */
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1); /* 添加阴影 */
}

.picker:after {
  content: '';
  display: inline-block;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid #999;
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
}

.button-group {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 40rpx;
  gap: 20rpx; /* 按钮之间的间距 */
}

.submit-btn {
  margin-top: 40rpx;
  height: 88rpx;
  width: 48%;
  background-color: #1890ff;
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(24, 144, 255, 0.2);
}

.cancel-btn {
  margin-top: 40rpx;
  width: 48%;
  height: 88rpx;
  background-color: #ee3d3d;
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(24, 144, 255, 0.2);
}

.submit-btn:active {
  background-color: #096dd9;
  transform: translateY(2rpx);
}

.cancel-btn:active {
  background-color: #fd0e0e;
  transform: translateY(2rpx);
}

/* 错误消息样式 */
.error-msg {
  color: #ff4d4f;
  font-size: 24rpx;
  margin-top: 8rpx;
  display: block;
}

/* 禁用状态 */
.input:disabled, .picker:disabled {
  background-color: #f5f5f5;
  color: #bfbfbf;
  cursor: not-allowed;
}
<view class="container">
  <view class="modal">
    <text class="title">修改产品信息</text>
    <view class="form-item">
      <text class="required">产品名称</text>
      <input class="input" placeholder="请输入产品名称" bindinput="onInputChange" data-field="productName" value="{{product.productName}}" />
    </view>

    <view class="form-item">
      <text>包装方式</text>
      <picker mode="selector" range="{{packagingMethodOptions}}" bindchange="onPickerChange" data-field="packagingMethod">
        <view class="picker">{{product.packagingMethod || "请选择包装方式"}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text>产品类型</text>
      <picker mode="selector" range="{{productTypeOptions}}" bindchange="onPickerChange" data-field="productType">
        <view class="picker">{{product.productType || "请选择产品类型"}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text>产品状态</text>
      <picker mode="selector" range="{{statusOptions}}" bindchange="onPickerChange" data-field="status">
        <view class="picker">{{product.status || "请选择产品状态"}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="required">每件重量 (kg)</text>
      <input class="input" type="digit" placeholder="请输入重量" bindinput="onInputChange" data-field="weightPerPiece" value="{{product.weightPerPiece}}" />
      <text class="error-msg" wx:if="{{errors.weightPerPiece}}">{{errors.weightPerPiece}}</text>
    </view>

    <view class="form-item">
      <text class="required">每板数量 (件)</text>
      <input class="input" type="number" placeholder="请输入数量" bindinput="onInputChange" data-field="piecesPerPallet" value="{{product.piecesPerPallet}}" />
      <text class="error-msg" wx:if="{{errors.piecesPerPallet}}">{{errors.piecesPerPallet}}</text>
    </view>

    <view class="form-item">
      <text>可堆积</text>
      <picker mode="selector" range="{{canStackOptions}}" bindchange="onPickerChange" data-field="canStack">
        <view class="picker">{{product.canStack ? "是" : "否"}}</view>
      </picker>
    </view>
    <view class="button-group">
      <button class="cancel-btn" bindtap="hideModal">取消</button>
      <button class="submit-btn" bindtap="submitForm">保存修改</button>
    </view>

  </view>
</view>
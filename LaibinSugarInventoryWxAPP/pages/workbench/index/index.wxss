.hero {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  padding: 28rpx;
  border: 1rpx solid rgba(36, 107, 254, 0.12);
  border-radius: 28rpx;
  color: #172033;
  background:
    radial-gradient(circle at 88% 12%, rgba(36, 107, 254, 0.14), transparent 30%),
    linear-gradient(135deg, #ffffff 0%, #f5f9ff 100%);
  box-shadow: 0 18rpx 46rpx rgba(23, 32, 51, 0.08);
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
}

.hero-eyebrow {
  font-size: 22rpx;
  font-weight: 700;
  color: #246bfe;
  letter-spacing: 1rpx;
}

.hello {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.date {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #647089;
}

.todo {
  width: 126rpx;
  height: 126rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #246bfe 0%, #165dff 100%);
  box-shadow: 0 18rpx 36rpx rgba(36, 107, 254, 0.28);
}

.todo-number {
  font-size: 46rpx;
  font-weight: 800;
}

.todo-label {
  margin-top: 4rpx;
  font-size: 23rpx;
}

.operation-panel {
  margin-top: 24rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(36, 107, 254, 0.16);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 90% 8%, rgba(36, 107, 254, 0.16), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #f6faff 100%);
  box-shadow: 0 18rpx 46rpx rgba(23, 32, 51, 0.08);
}

.operation-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.operation-title {
  font-size: 36rpx;
  font-weight: 850;
  color: #172033;
}

.operation-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #647089;
}

.main-scan-btn {
  flex-shrink: 0;
  width: 176rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  border-radius: 22rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #246bfe, #165dff);
  box-shadow: 0 16rpx 30rpx rgba(36, 107, 254, 0.24);
  font-size: 27rpx;
  font-weight: 800;
}

.main-scan-btn::after {
  border: 0;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 112rpx;
  padding: 18rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
}

.primary-entry {
  border-color: rgba(36, 107, 254, 0.22);
  background: #ffffff;
}

.secondary-entry {
  background: rgba(251, 252, 254, 0.72);
}

.action-icon {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
}

.action-title {
  font-size: 27rpx;
  font-weight: 800;
  color: #172033;
}

.action-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: #647089;
}

.action-arrow {
  margin-left: auto;
  color: #9aa6b7;
  font-size: 34rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
}

.no-margin {
  margin: 0;
}

.text-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 16rpx;
  color: #246bfe;
  background: #eaf1ff;
  font-size: 24rpx;
}

.text-btn::after {
  border: 0;
}

.scan-list,
.tips {
  border: 1rpx solid #e7edf5;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(23, 32, 51, 0.055);
}

.scan-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #edf1f6;
}

.scan-row:last-child {
  border-bottom: 0;
}

.scan-code {
  font-size: 30rpx;
  font-weight: 800;
  color: #172033;
}

.scan-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #647089;
}

.arrow {
  color: #246bfe;
  font-size: 24rpx;
}

.tip {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #edf1f6;
  font-size: 25rpx;
  line-height: 1.5;
  color: #526072;
}

.tip-icon {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin-top: 4rpx;
}

.tip-text {
  flex: 1;
  min-width: 0;
}

.tip:last-child {
  border-bottom: 0;
}

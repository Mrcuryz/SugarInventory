<page-shell>
  <page-header title="工作台" subtitle="现场扫码作业入口" />

  <view class="hero">
    <view class="hero-copy">
      <view class="hero-eyebrow">现场值班台</view>
      <view class="hello">你好，{{userInfo.name || userInfo.username || '作业员'}}</view>
      <view class="date">{{currentDate}}</view>
      <view class="hero-tip">高频作业优先从扫码入口开始，减少手工查找和二次确认。</view>
      <view class="hero-badges">
        <text class="hero-badge">扫码优先</text>
        <text class="hero-badge">连续作业</text>
        <text class="hero-badge">任务闭环</text>
      </view>
    </view>
    <view class="todo" bindtap="goTasks">
      <text class="todo-number">{{pendingCount}}</text>
      <text class="todo-label">待处理</text>
    </view>
  </view>

  <view class="section-title">快捷作业</view>
  <view class="action-grid">
    <view wx:for="{{actions}}" wx:key="key" class="action-card {{index === 0 ? 'primary-entry' : ''}} {{item.route ? 'secondary-entry' : ''}}" data-mode="{{item.mode}}" data-route="{{item.route}}" bindtap="goScan">
      <view class="action-head">
        <image class="action-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <text class="action-tag">{{index === 0 ? '主入口' : item.route ? '查询' : '作业'}}</text>
      </view>
      <view class="action-title">{{item.title}}</view>
      <view class="action-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title no-margin">最近任务</view>
    <button class="text-btn" bindtap="goTasks">全部</button>
  </view>
  <view wx:if="{{recentTasks.length}}">
    <task-card wx:for="{{recentTasks}}" wx:key="taskId" task="{{item}}" />
  </view>
  <empty-state wx:else title="暂无待处理任务" description="连续扫码后，任务会在这里出现。" />

  <view class="section-title">最近扫码</view>
  <view wx:if="{{recentScans.length}}" class="scan-list">
    <view wx:for="{{recentScans}}" wx:key="code" class="scan-row" data-code="{{item.code}}" bindtap="goPallet">
      <view>
        <view class="scan-code">{{item.code}}</view>
        <view class="scan-meta">{{item.modeLabel || '扫码'}} · {{item.scannedAtText}}</view>
      </view>
      <text class="arrow">查看</text>
    </view>
  </view>
  <empty-state wx:else title="暂无扫码记录" description="从扫码页完成操作后会保留最近记录。" />

  <view class="section-title">系统提醒</view>
  <view class="tips">
    <view wx:for="{{tips}}" wx:key="*this" class="tip">{{item}}</view>
  </view>
</page-shell>

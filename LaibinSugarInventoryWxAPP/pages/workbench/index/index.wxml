<page-shell>
  <page-header title="工作台" subtitle="现场扫码作业入口" />

  <view class="hero">
    <view class="hero-copy">
      <view class="hero-eyebrow">现场值班台</view>
      <view class="hello">{{userInfo.name || userInfo.username || '作业员'}}</view>
      <view class="date">{{currentDate}} · 开工先扫码，任务集中处理</view>
    </view>
    <view class="todo" bindtap="goTasks">
      <text class="todo-number">{{pendingCount}}</text>
      <text class="todo-label">待处理</text>
    </view>
  </view>

  <view class="operation-panel">
    <view class="operation-head">
      <view>
        <view class="operation-title">扫码作业</view>
        <view class="operation-desc">入库、出库、调拨和生产订单现场执行从这里开始。</view>
      </view>
      <button class="main-scan-btn" data-mode="in" bindtap="goScan">开始入库</button>
    </view>
    <view class="action-grid">
      <view wx:for="{{actions}}" wx:key="key" class="action-card {{item.primary ? 'primary-entry' : ''}} {{item.route ? 'secondary-entry' : ''}}" data-mode="{{item.mode}}" data-route="{{item.route}}" bindtap="goScan">
        <image class="action-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <view>
          <view class="action-title">{{item.title}}</view>
          <view class="action-desc">{{item.desc}}</view>
        </view>
        <text class="action-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title no-margin">最近任务</view>
    <button class="text-btn" bindtap="goTasks">全部</button>
  </view>
  <view wx:if="{{recentTasks.length}}">
    <task-card wx:for="{{recentTasks}}" wx:key="taskId" task="{{item}}" />
  </view>
  <empty-state wx:else icon="/assets/icons-line/icon-task.svg" title="暂无待处理任务" description="连续扫码后，任务会在这里出现。" />

  <view class="section-title">最近扫码</view>
  <view wx:if="{{recentScans.length}}" class="scan-list">
    <view wx:for="{{recentScans}}" wx:key="code" class="scan-row" data-code="{{item.code}}" bindtap="goPallet">
      <view>
        <view class="scan-code">{{item.code}}</view>
        <view class="scan-meta">{{item.modeLabel || '扫码'}} · {{item.scannedAtText}}</view>
      </view>
      <text class="arrow">查看</text>
    </view>
  </view>
  <empty-state wx:else icon="/assets/icons-line/icon-search.svg" title="暂无扫码记录" description="从扫码页完成操作后会保留最近记录。" />

  <view class="section-title">系统提醒</view>
  <view class="tips">
    <view wx:for="{{tips}}" wx:key="*this" class="tip">
      <image class="tip-icon" src="/assets/icons-line/icon-notice.svg" mode="aspectFit"></image>
      <text class="tip-text">{{item}}</text>
    </view>
  </view>
</page-shell>

.task-card {
  margin-bottom: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #e3e9f2;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  box-shadow: 0 12rpx 32rpx rgba(23, 32, 51, 0.065);
  overflow: hidden;
}

.selected {
  border-color: #246bfe;
  box-shadow: 0 0 0 2rpx rgba(36, 107, 254, 0.08), 0 10rpx 28rpx rgba(23, 32, 51, 0.06);
}

.is-success {
  border-color: #d9efdf;
}

.is-error {
  border-color: #f5d7d7;
  background: #fffdfd;
}

.card-main {
  display: flex;
  gap: 18rpx;
}

.check {
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
  margin-top: 6rpx;
  border: 2rpx solid #a8b3c4;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.checked {
  border-color: #246bfe;
  background: #246bfe;
  box-shadow: inset 0 0 0 8rpx #ffffff, 0 0 0 4rpx rgba(36, 107, 254, 0.12);
}

.task-content {
  flex: 1;
  min-width: 0;
}

.top-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.code {
  font-size: 34rpx;
  font-weight: 800;
  color: #172033;
  letter-spacing: 0.5rpx;
}

.product {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 750;
  color: #2c3648;
}

.meta,
.message,
.production-context {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #647089;
}

.production-context {
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #f4f7fc;
  color: #2d3b54;
}

.message {
  color: #ba1a1a;
}

.actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1f6;
}

.action {
  min-width: 0;
  height: 66rpx;
  line-height: 66rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.action::after {
  border: 0;
}

.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #246bfe, #165dff);
}

.plain {
  color: #246bfe;
  background: #eaf1ff;
}

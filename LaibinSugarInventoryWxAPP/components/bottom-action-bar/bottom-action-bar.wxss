.bottom-action-bar {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e3e9f2;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 34rpx rgba(23, 32, 51, 0.08);
  box-sizing: border-box;
}

.fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
}

.action {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  margin: 0;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 750;
}

.action::after {
  border: 0;
}

.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #246bfe, #165dff);
  box-shadow: 0 14rpx 28rpx rgba(36, 107, 254, 0.2);
}

.plain {
  color: #246bfe;
  background: #eaf1ff;
}

.danger {
  color: #d92d20;
  background: #fff1f1;
}

.disabled {
  color: #a8b3c4;
  background: #eef2f6;
}


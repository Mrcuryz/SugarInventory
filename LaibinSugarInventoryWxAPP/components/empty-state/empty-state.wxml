<view class="empty-state">
  <view wx:if="{{icon}}" class="empty-mark icon-mark">
    <image class="empty-icon" src="{{icon}}" mode="aspectFit"></image>
  </view>
  <view wx:else class="empty-mark">
    <view class="empty-line short"></view>
    <view class="empty-line"></view>
    <view class="empty-dot"></view>
  </view>
  <view class="empty-title">{{title}}</view>
  <view wx:if="{{description}}" class="empty-desc">{{description}}</view>
  <button wx:if="{{actionText}}" class="empty-action" bindtap="onAction">{{actionText}}</button>
</view>


.empty-state {
  padding: 56rpx 32rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  box-shadow: 0 10rpx 26rpx rgba(23, 32, 51, 0.055);
  text-align: center;
  color: #647089;
}

.empty-mark {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #eaf1ff, #eef8f2);
  box-shadow: inset 0 0 0 1rpx rgba(36, 107, 254, 0.08);
}

.icon-mark {
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  width: 48rpx;
  height: 48rpx;
}

.empty-line {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #b7c9ff;
  top: 40rpx;
}

.empty-line.short {
  right: 44rpx;
  top: 58rpx;
  background: #b8e7cf;
}

.empty-dot {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #246bfe;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #172033;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.empty-action {
  margin-top: 24rpx;
  width: 240rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #246bfe, #165dff);
  box-shadow: 0 14rpx 28rpx rgba(36, 107, 254, 0.22);
}

.empty-action::after {
  border: 0;
}


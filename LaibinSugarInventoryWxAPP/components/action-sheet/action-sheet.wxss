.sheet-layer {
  position: fixed;
  inset: 0;
  z-index: 90;
}

.mask {
  position: absolute;
  inset: 0;
  background: rgba(16, 24, 40, 0.48);
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  box-shadow: 0 -20rpx 50rpx rgba(23, 32, 51, 0.16);
}

.sheet-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #172033;
}

.sheet-action,
.sheet-cancel {
  height: 78rpx;
  line-height: 78rpx;
  margin: 0 0 14rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
}

.sheet-action::after,
.sheet-cancel::after {
  border: 0;
}

.sheet-action {
  color: #ffffff;
  background: linear-gradient(135deg, #246bfe, #165dff);
}

.sheet-cancel {
  color: #526072;
  background: #eef2f6;
}


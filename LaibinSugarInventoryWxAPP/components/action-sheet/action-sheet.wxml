<view wx:if="{{visible}}" class="sheet-layer" catchtouchmove="noop">
  <view class="mask" bindtap="onClose" catchtouchmove="noop"></view>
  <view class="sheet" catchtouchmove="noop">
    <view class="sheet-title">{{title || '选择操作'}}</view>
    <button wx:for="{{actions}}" wx:key="key" class="sheet-action" data-index="{{index}}" bindtap="onAction">{{item.label}}</button>
    <button class="sheet-cancel" bindtap="onClose">取消</button>
  </view>
</view>


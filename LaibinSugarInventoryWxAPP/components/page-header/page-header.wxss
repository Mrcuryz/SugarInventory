.page-header {
  margin-bottom: 24rpx;
}

.header-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.title-block {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #172033;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #647089;
}

.back-btn,
.action-btn {
  margin: 0;
  padding: 0 20rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #246bfe;
  background: #eaf1ff;
}

.back-btn::after,
.action-btn::after {
  border: 0;
}


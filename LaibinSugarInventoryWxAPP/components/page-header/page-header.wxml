<view class="page-header">
  <view class="header-row">
    <button wx:if="{{showBack}}" class="back-btn" bindtap="onBack">返回</button>
    <view class="title-block">
      <view class="title">{{title}}</view>
      <view wx:if="{{subtitle}}" class="subtitle">{{subtitle}}</view>
    </view>
    <button wx:if="{{actionText}}" class="action-btn" bindtap="onAction">{{actionText}}</button>
  </view>
</view>


.pager {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(23, 32, 51, 0.055);
}

.pager-info,
.pager-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pager-info {
  font-size: 23rpx;
  color: #7a869a;
}

.pager-range {
  color: #526072;
}

.pager-actions {
  margin-top: 16rpx;
  gap: 14rpx;
}

.pager-btn {
  flex: 1;
  height: 62rpx;
  line-height: 62rpx;
  margin: 0;
  border-radius: 16rpx;
  background: #eaf1ff;
  color: #246bfe;
  font-size: 24rpx;
  font-weight: 750;
}

.pager-btn::after {
  border: 0;
}

.pager-btn.disabled {
  color: #a0a9b8;
  background: #f1f4f8;
}

.pager-page {
  flex-shrink: 0;
  min-width: 130rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 850;
  color: #172033;
}

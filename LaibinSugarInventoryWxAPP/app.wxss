/**app.wxss**/
page {
  min-height: 100%;
  background: #f4f7fb;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --brand-blue: #246bfe;
  --brand-blue-deep: #165dff;
  --brand-blue-soft: #eaf1ff;
  --success: #10a56a;
  --success-soft: #e9f8ef;
  --warning: #ff8a00;
  --warning-soft: #fff4df;
  --danger: #d92d20;
  --danger-soft: #fff1f1;
  --text-main: #172033;
  --text-sub: #526072;
  --text-muted: #7a869a;
  --line-soft: #e7edf5;
  --panel: #ffffff;
  --panel-soft: #f8fbff;
  --page-bg: #f4f7fb;
  --radius-card: 24rpx;
  --radius-control: 18rpx;
  --shadow-card: 0 16rpx 42rpx rgba(23, 32, 51, 0.08);
  --shadow-soft: 0 10rpx 26rpx rgba(23, 32, 51, 0.055);
  --shadow-primary: 0 18rpx 36rpx rgba(36, 107, 254, 0.24);
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

button {
  letter-spacing: 0;
}

.container {
  min-height: 100%;
  box-sizing: border-box;
}

.surface-card {
  border: 1rpx solid var(--line-soft);
  border-radius: var(--radius-card);
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  box-shadow: var(--shadow-soft);
}

.section-title {
  margin: 36rpx 0 18rpx;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 700;
  color: var(--text-main);
}

.muted {
  color: var(--text-muted);
}

.glass-card {
  border: 1rpx solid rgba(36, 107, 254, 0.1);
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, #ffffff 0%, #f7fbff 100%);
  box-shadow: var(--shadow-card);
}

.mini-card {
  border: 1rpx solid var(--line-soft);
  border-radius: 20rpx;
  background: var(--panel);
  box-shadow: var(--shadow-soft);
}

.primary-btn,
.secondary-btn,
.danger-btn {
  height: 84rpx;
  line-height: 84rpx;
  margin: 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 750;
}

.primary-btn::after,
.secondary-btn::after,
.danger-btn::after {
  border: 0;
}

.primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand-blue) 0%, var(--brand-blue-deep) 100%);
  box-shadow: var(--shadow-primary);
}

.secondary-btn {
  color: var(--brand-blue);
  background: var(--brand-blue-soft);
}

.danger-btn {
  color: var(--danger);
  background: var(--danger-soft);
}

.segmented {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border: 1rpx solid #e2e9f3;
  border-radius: 22rpx;
  background: #edf3fb;
}

.segmented-item {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 750;
  color: var(--text-sub);
}

.segmented-item.active {
  color: var(--brand-blue);
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(23, 32, 51, 0.08);
}

.modal-layer,
.modal {
  z-index: 90;
}

.modal-mask,
.modal-overlay,
.mask {
  backdrop-filter: blur(8rpx);
}

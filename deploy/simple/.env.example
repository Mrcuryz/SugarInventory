# 只需首次复制为 .env。随机密钥由 init-env.sh 自动生成。
DB_URL=jdbc:mysql://host.docker.internal:3306/laibin_sugar_inventory?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
# Web 演示登录口令需同时满足前端长度限制和后端至少 12 位的安全校验，不随机生成。
WEB_LOGIN_PASSWORD=lbsp88888888

# 已有数据库首次接入迁移台账时才填写，并必须由发布负责人确认该版本以前的变更确已存在。
# 新数据库或已建立 schema_migration 台账的数据库保持为空。
DB_MIGRATION_BASELINE_THROUGH=
DB_MIGRATION_LOCK_TIMEOUT_MINUTES=30

# 如服务器使用微信登录或模型服务，再填写对应值；未使用时可留空。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Python Agent 必须保持模型主导的规划链路。三个阶段模型留空时复用 AGENT_MODEL_NAME。
AGENT_PYTHON_MODEL_MODE=openai_compatible
AGENT_PLANNING_MODE=llm
AGENT_LLM_ALLOWED_EXPERTS=inventory_expert,warehouse_expert,assay_expert,logistics_expert,production_expert,analytics_expert,pallet_expert,knowledge_expert,master_data_expert,administration_expert,audit_expert
AGENT_MODEL_BASE_URL=https://api.openai.com/v1
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=gpt-4.1-mini
AGENT_MAIN_ROUTE_MODEL_NAME=
AGENT_EXPERT_INITIAL_MODEL_NAME=
AGENT_EXPERT_RESULT_MODEL_NAME=

JWT_SECRET=GENERATED_BY_INIT
AGENT_PYTHON_SERVICE_KEY=GENERATED_BY_INIT
AGENT_INTERNAL_TOOL_SERVICE_KEY=GENERATED_BY_INIT
AGENT_ENTITY_REF_SECRET=GENERATED_BY_INIT
REDIS_PASSWORD=GENERATED_BY_INIT

# RAG 首次发布并验证通过后再设为 true；生产启用时 required 必须为 true。
# artifacts/rag 与 artifacts/rag-model 是独立发布制品，源码构建不能替代；启用前 update.sh
# 会校验 current 指针、完整 release、固定评测和本地模型合同，任一缺失都停止发布。
AGENT_RAG_ENABLED=false
AGENT_RAG_REQUIRED=false
AGENT_RAG_ROOT=/app/rag
AGENT_RAG_MODEL_PATH=/app/rag-model
AGENT_RAG_MODEL_NAME=BAAI/bge-small-zh-v1.5
AGENT_RAG_MODEL_THREADS=2
AGENT_RAG_QUERY_TIMEOUT_MS=5000
AGENT_RAG_MAX_EVIDENCE=5

TZ=Asia/Shanghai

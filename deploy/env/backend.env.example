DB_USERNAME=laibin_app
DB_PASSWORD=
JWT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AGENT_RUNTIME_MODE=python
AGENT_PYTHON_BASE_URL=http://127.0.0.1:8091
AGENT_PYTHON_TIMEOUT_MS=100000
AGENT_PYTHON_SERVICE_KEY=
AGENT_INTERNAL_TOOL_SERVICE_KEY=
AGENT_MCP_RUNTIME_VERIFICATION_ENABLED=true
AGENT_RUNTIME_FALLBACK_ENABLED=false
INVENTORY_HISTORY_MAX_CAPTURE_DELAY_MINUTES=10
INVENTORY_TREND_SIMULATION_ENABLED=false
# Registered report snapshots expire after 30 days. The cleanup task deletes expired payloads
# in bounded batches while retaining export audit metadata and a separate cleanup audit record.
AGENT_REPORT_CLEANUP_ENABLED=true
AGENT_REPORT_CLEANUP_CRON=0 30 2 * * ?
AGENT_REPORT_CLEANUP_BATCH_SIZE=1000

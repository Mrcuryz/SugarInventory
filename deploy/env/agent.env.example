AGENT_ENV=production
AGENT_TOOL_MODE=java_gateway
AGENT_PYTHON_MODEL_MODE=basic
AGENT_RUN_TIMEOUT_MS=90000
AGENT_MODEL_TIMEOUT_MS=45000
# Optional stage overrides. Leave empty/omit to reuse AGENT_MODEL_NAME.
AGENT_MAIN_ROUTE_MODEL_NAME=
AGENT_EXPERT_INITIAL_MODEL_NAME=
AGENT_EXPERT_RESULT_MODEL_NAME=
JAVA_TOOL_GATEWAY_BASE_URL=http://127.0.0.1:8080
AGENT_PYTHON_SERVICE_KEY=
AGENT_INTERNAL_TOOL_SERVICE_KEY=
AGENT_STATE_BACKEND=redis
AGENT_REDIS_URL=redis://agent_state:CHANGE_ME@127.0.0.1:6379/0
AGENT_STATE_TTL_SECONDS=3600
AGENT_SESSION_LOCK_WAIT_MS=5000
AGENT_SESSION_LOCK_LEASE_MS=30000
AGENT_ALLOW_INSECURE_MOCK_AUTH=false
AGENT_LLM_ALLOWED_EXPERTS=inventory_expert,warehouse_expert,assay_expert,logistics_expert,production_expert,analytics_expert,pallet_expert,knowledge_expert
AGENT_RAG_ENABLED=false
AGENT_RAG_REQUIRED=false
AGENT_RAG_ROOT=/app/rag
AGENT_RAG_MODEL_PATH=/app/models/BAAI-bge-small-zh-v1.5
AGENT_RAG_MODEL_NAME=BAAI/bge-small-zh-v1.5
AGENT_RAG_MODEL_THREADS=2
AGENT_RAG_QUERY_TIMEOUT_MS=5000
AGENT_RAG_MAX_EVIDENCE=5

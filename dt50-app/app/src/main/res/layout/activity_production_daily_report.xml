<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:id="@+id/dailyBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="返回"
            android:padding="12dp"
            android:src="@drawable/ic_daily_back"
            android:tint="@color/primary" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">
            <TextView
                android:id="@+id/dailyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="生产日报"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/dailySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/dailyMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="更多操作"
            android:padding="12dp"
            android:src="@drawable/ic_daily_more"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/dailyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_feedback_info"
        android:padding="10dp"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dailyTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/page_background"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/dailyScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/dailyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/dailyBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">
        <Button
            android:id="@+id/dailySecondaryAction"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_feedback_info"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/dailyPrimaryAction"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

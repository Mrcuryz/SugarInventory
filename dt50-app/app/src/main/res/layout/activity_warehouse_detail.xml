<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <TextView
            android:id="@+id/detailBackButton"
            android:layout_width="58dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_outline"
            android:gravity="center"
            android:text="‹  返回"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/detailTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="库位详情"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/detailSubtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
        <Button
            android:id="@+id/detailRefreshButton"
            android:layout_width="60dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_outline"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="刷新"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp">
            <TextView
                android:id="@+id/detailStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_feedback_info"
                android:padding="12dp"
                android:text="正在读取实时库存…"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="bottom"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="当前库存"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="按产品汇总"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/detailInventoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/detailInventoryEmptyText"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_empty_state"
                android:gravity="center"
                android:text="当前库位暂无库存"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="bottom"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="最近操作"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/detailOperationList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/detailOperationEmptyText"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_empty_state"
                android:gravity="center"
                android:text="暂无最近操作记录"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
